# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Production Required ──────────────────────────────────────────────────
# HOST_PIN: Secure PIN for host/admin access (REQUIRED in production)
# Generate with: openssl rand -hex 3
HOST_PIN="123456"

# NODE_ENV: Set to 'production' for production builds
NODE_ENV="production"

# PORT: Server port (Cloud Run sets this automatically to 8080)
PORT="8080"

# ─── Cloud SQL (Optional - for persistent database) ───────────────────────
# INSTANCE_CONNECTION_NAME: Auto-set by Cloud Run when using --add-cloudsql-instances
# Format: project:region:instance
# INSTANCE_CONNECTION_NAME="my-project:us-central1:trivia-db"

# DB_NAME: Database name in Cloud SQL (default: trivia)
# DB_NAME="trivia"
