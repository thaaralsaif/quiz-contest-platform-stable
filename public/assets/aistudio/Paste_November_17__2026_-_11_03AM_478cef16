<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="luxury" data-font="cairo-almarai">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>بطولة النخبة الكبرى للمسابقات</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=Cairo:wght@600;700;900&family=IBM+Plex+Sans+Arabic:wght@500;700&family=Tajawal:wght@500;800&display=swap" rel="stylesheet">
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

  <style>
    /* ==========================================================================
       1. مصفوفة المتغيرات الديناميكية (6 ثيمات عالية التباين + 3 باقات خطوط)
       ========================================================================== */
    :root, [data-theme="snow"] {
      --bg-canvas: #F8FAFC;
      --bg-card: #FFFFFF;
      --border-subtle: #CBD5E1;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --icon-container-bg: #E0F2FE;
      --icon-primary: #0284C7;
      --buzzer-bg: #E2E8F0;
      --buzzer-border: #0284C7;
      --buzzer-text: #0F172A;
      --powerup-bg: #F1F5F9;
      --powerup-border: #CBD5E1;
      --powerup-text: #1E293B;
      --badge-live-bg: #FEE2E2;
      --badge-live-text: #B91C1C;
      --state-success-bg: #DCFCE7;
      --state-success-border: #16A34A;
      --state-success-text: #14532D;
      --state-error-bg: #FEE2E2;
      --state-error-border: #DC2626;
      --state-error-text: #7F1D1D;
    }

    [data-theme="sunrise"] {
      --bg-canvas: #FFF7ED;
      --bg-card: #FFFFFF;
      --border-subtle: #FED7AA;
      --text-primary: #431407;
      --text-secondary: #7C2D12;
      --icon-container-bg: #FFEDD5;
      --icon-primary: #EA580C;
      --buzzer-bg: #FFEDD5;
      --buzzer-border: #F97316;
      --buzzer-text: #431407;
      --powerup-bg: #FFF7ED;
      --powerup-border: #FDBA74;
      --powerup-text: #7C2D12;
      --badge-live-bg: #FFE4E6;
      --badge-live-text: #BE123C;
    }

    [data-theme="luxury"] {
      --bg-canvas: #FAFAF9;
      --bg-card: #FFFFFF;
      --border-subtle: #E7E5E4;
      --text-primary: #1C1917;
      --text-secondary: #57534E;
      --icon-container-bg: #FEF3C7;
      --icon-primary: #D97706;
      --buzzer-bg: #FEF3C7;
      --buzzer-border: #D97706;
      --buzzer-text: #1C1917;
      --powerup-bg: #F5F5F4;
      --powerup-border: #D6D3D1;
      --powerup-text: #292524;
      --badge-live-bg: #FEE2E2;
      --badge-live-text: #991B1B;
    }

    [data-theme="azure"] {
      --bg-canvas: #F0F9FF;
      --bg-card: #FFFFFF;
      --border-subtle: #BAE6FD;
      --text-primary: #082F49;
      --text-secondary: #0369A1;
      --icon-container-bg: #E0F2FE;
      --icon-primary: #0284C7;
      --buzzer-bg: #E0F2FE;
      --buzzer-border: #0369A1;
      --buzzer-text: #082F49;
      --powerup-bg: #F0F9FF;
      --powerup-border: #7DD3FC;
      --powerup-text: #0C4A6E;
      --badge-live-bg: #FEE2E2;
      --badge-live-text: #B91C1C;
    }

    [data-theme="lavender"] {
      --bg-canvas: #FAF5FF;
      --bg-card: #FFFFFF;
      --border-subtle: #E9D5FF;
      --text-primary: #3B0764;
      --text-secondary: #6B21A8;
      --icon-container-bg: #F3E8FF;
      --icon-primary: #9333EA;
      --buzzer-bg: #F3E8FF;
      --buzzer-border: #9333EA;
      --buzzer-text: #3B0764;
      --powerup-bg: #FAF5FF;
      --powerup-border: #D8B4FE;
      --powerup-text: #581C87;
      --badge-live-bg: #FCE7F3;
      --badge-live-text: #9D174D;
    }

    [data-theme="classic"] {
      --bg-canvas: #0B0F19;
      --bg-card: #1E293B;
      --border-subtle: #334155;
      --text-primary: #F8FAFC;
      --text-secondary: #94A3B8;
      --icon-container-bg: #1E293B;
      --icon-primary: #FACC15;
      --buzzer-bg: #1E293B;
      --buzzer-border: #38BDF8;
      --buzzer-text: #F8FAFC;
      --powerup-bg: #0F172A;
      --powerup-border: #334155;
      --powerup-text: #CBD5E1;
      --badge-live-bg: #450A0A;
      --badge-live-text: #FCA5A5;
      --state-success-bg: #064E3B;
      --state-success-border: #34D399;
      --state-success-text: #A7F3D0;
      --state-error-bg: #7F1D1D;
      --state-error-border: #F87171;
      --state-error-text: #FECACA;
    }

    :root, [data-font="cairo-almarai"] { --font-display: 'Cairo', sans-serif; --font-body: 'Almarai', sans-serif; }
    [data-font="tajawal"] { --font-display: 'Tajawal', sans-serif; --font-body: 'Tajawal', sans-serif; }
    [data-font="ibm"] { --font-display: 'IBM Plex Sans Arabic', sans-serif; --font-body: 'IBM Plex Sans Arabic', sans-serif; }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      font-family: var(--font-body);
      min-height: 100dvh;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    h1, h2, h3, .font-display { font-family: var(--font-display); }
    .hidden { display: none !important; }

    .toast-banner {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--text-primary);
      color: var(--bg-canvas);
      padding: 10px 22px;
      border-radius: 99px;
      font-weight: 800;
      font-size: 14px;
      z-index: 9999;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      max-width: 92vw;
      text-align: center;
    }

    /* ==========================================================================
       2. شاشة العرض التلفزيوني (TV BROADCAST VIEW)
       ========================================================================== */
    .tv-layout {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100dvh;
      width: 100%;
      max-width: 100%;
      padding: 18px 28px;
      position: relative;
    }
    .tv-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 2px solid var(--border-subtle);
      flex-wrap: wrap;
      gap: 10px;
      z-index: 2;
    }
    .live-badge {
      background-color: var(--badge-live-bg);
      color: var(--badge-live-text);
      padding: 5px 12px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 13px;
      border: 1px solid var(--badge-live-text);
    }
    .round-pill {
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      padding: 5px 14px;
      border-radius: 99px;
      font-weight: 900;
      font-size: 14px;
      border: 1px solid var(--icon-primary);
    }
    .tv-stage {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 16px 0;
      width: 100%;
      z-index: 2;
    }
    .icon-box-lg {
      width: 78px;
      height: 78px;
      border-radius: 20px;
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      border: 2px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .turn-banner {
      background-color: var(--icon-container-bg);
      border: 2px solid var(--icon-primary);
      color: var(--text-primary);
      padding: 10px 20px;
      border-radius: 16px;
      font-size: 18px;
      font-weight: 900;
      margin-bottom: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      max-width: 100%;
    }
    .powerup-live-banner {
      background-color: var(--state-success-bg);
      border: 2px solid var(--state-success-border);
      color: var(--state-success-text);
      padding: 10px 20px;
      border-radius: 14px;
      font-weight: 900;
      font-size: 17px;
      margin-bottom: 14px;
      width: 100%;
      max-width: 1020px;
    }
    .referee-live-banner {
      background-color: var(--icon-container-bg);
      border: 2px solid var(--icon-primary);
      color: var(--text-primary);
      padding: 10px 20px;
      border-radius: 14px;
      font-weight: 900;
      font-size: 16px;
      margin-bottom: 14px;
      width: 100%;
      max-width: 1020px;
    }
    .answer-timer-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background-color: var(--state-error-bg);
      border: 2px solid var(--state-error-border);
      color: var(--state-error-text);
      padding: 8px 18px;
      border-radius: 12px;
      font-weight: 900;
      font-size: 20px;
      margin-top: 12px;
      animation: pulseText 0.8s infinite;
    }
    .categories-board-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      width: 100%;
      max-width: 1180px;
    }
    .cat-column-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 18px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }
    .cat-column-title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 900;
      color: var(--icon-primary);
      padding-bottom: 8px;
      border-bottom: 2px solid var(--border-subtle);
    }
    .diff-slot-tile {
      padding: 10px 12px;
      border-radius: 12px;
      border: 2px solid var(--border-subtle);
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 800;
      font-size: 15px;
    }
    .diff-slot-tile.is-empty { opacity: 0.35; text-decoration: line-through; filter: grayscale(1); }
    .diff-pts-badge {
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      padding: 3px 9px;
      border-radius: 8px;
      font-weight: 900;
      font-size: 13px;
    }

    .question-box {
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 22px;
      padding: 24px;
      width: 100%;
      max-width: 1020px;
    }
    .category-pill {
      display: inline-block;
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      padding: 6px 16px;
      border-radius: 99px;
      font-weight: 800;
      margin-bottom: 12px;
      font-size: 14px;
    }
    .options-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 20px;
    }
    .option-card {
      background-color: var(--bg-canvas);
      border: 2px solid var(--border-subtle);
      border-radius: 14px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 18px;
      font-weight: 700;
      text-align: right;
      min-width: 0;
      word-break: break-word;
    }
    .option-letter {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      flex-shrink: 0;
    }
    .option-card.is-correct {
      background-color: var(--state-success-bg);
      border-color: var(--state-success-border);
      color: var(--state-success-text);
    }
    .option-card.is-eliminated { opacity: 0.2; text-decoration: line-through; filter: grayscale(1); }
    .buzzer-alert-banner {
      margin-top: 18px;
      padding: 12px 20px;
      border-radius: 14px;
      background-color: var(--icon-container-bg);
      border: 2px solid var(--icon-primary);
      color: var(--text-primary);
      font-size: 19px;
      font-weight: 900;
    }

    .podium-grid {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 14px;
      margin: 20px 0;
      flex-wrap: wrap;
    }
    .podium-step {
      background-color: var(--bg-card);
      border: 3px solid var(--border-subtle);
      border-radius: 18px;
      padding: 18px;
      min-width: 190px;
      text-align: center;
    }
    .podium-1 { border-color: #EAB308; }
    .podium-2 { border-color: #94A3B8; }
    .podium-3 { border-color: #D97706; }

    #confetti-canvas { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }

    .tv-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 12px;
      border-top: 2px solid var(--border-subtle);
      gap: 12px;
      z-index: 2;
      width: 100%;
    }
    .teams-bar {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
      gap: 8px;
      min-width: 0;
    }
    .team-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 12px;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .team-card.is-active-turn { border-color: var(--icon-primary); box-shadow: 0 0 0 2px var(--icon-primary); }
    .team-card.is-eliminated { opacity: 0.4; filter: grayscale(0.9); border-style: dashed; }
    .team-rank {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: #fff;
      flex-shrink: 0;
    }
    .timer-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 14px;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .timer-urgent { color: #DC2626 !important; animation: pulseText 0.7s infinite; }
    @keyframes pulseText { 50% { opacity: 0.45; } }

    /* ==========================================================================
       3. وحدة تحكم المتسابق (MOBILE CONTROLLER VIEW)
       ========================================================================== */
    .mobile-layout {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      min-height: 100dvh;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
    }
    .mobile-status-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 16px;
      padding: 14px;
      margin-top: 8px;
    }
    .buzzer-wrapper { display: flex; align-items: center; justify-content: center; margin: 10px 0; }
    .buzzer-btn {
      width: 195px;
      height: 195px;
      border-radius: 50%;
      background-color: var(--buzzer-bg);
      border: 6px solid var(--buzzer-border);
      color: var(--buzzer-text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 12px 28px rgba(0,0,0,0.12);
      transition: transform 0.1s ease;
      text-align: center;
      padding: 12px;
    }
    .buzzer-btn:active:not(:disabled) { transform: scale(0.94); }
    .buzzer-btn:disabled { opacity: 0.85; cursor: not-allowed; }
    .buzzer-btn.state-ready { background-color: var(--icon-primary); color: #FFFFFF; }
    .buzzer-btn.state-winner { background-color: var(--state-success-bg); border-color: var(--state-success-border); color: var(--state-success-text); }
    .buzzer-btn.state-blocked { background-color: var(--state-error-bg); border-color: var(--state-error-border); color: var(--state-error-text); }

    .powerups-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; margin-top: 8px; }
    .powerup-btn {
      background-color: var(--powerup-bg);
      border: 2px solid var(--powerup-border);
      color: var(--powerup-text);
      border-radius: 12px;
      padding: 9px 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 11.5px;
      font-weight: 800;
      cursor: pointer;
      min-width: 0;
    }
    .powerup-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .pu-count-pill {
      background-color: var(--icon-container-bg);
      color: var(--icon-primary);
      padding: 1px 7px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 900;
    }

    /* نافذة اختيار الفريق المستهدف لسرقة النقاط (Targeted Steal Modal) */
    .steal-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.72);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 9998;
    }
    .steal-modal-card {
      background-color: var(--bg-card);
      border: 2px solid var(--icon-primary);
      border-radius: 18px;
      padding: 18px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.28);
    }
    .steal-victim-btn {
      width: 100%;
      padding: 12px 14px;
      margin-bottom: 8px;
      border-radius: 12px;
      border: 2px solid var(--border-subtle);
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 14px;
      cursor: pointer;
    }
    .steal-victim-btn:active {
      border-color: var(--icon-primary);
      background-color: var(--icon-container-bg);
    }

    /* ==========================================================================
       4. غرفة القيادة واستوديو الإعدادات (HOST & SETTINGS)
       ========================================================================== */
    .container-wide {
      width: 100%;
      max-width: 1180px;
      margin: 0 auto;
      padding: 18px;
    }
    .panel-card {
      width: 100%;
      max-width: 100%;
      background-color: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: 18px;
      padding: 18px;
      margin-bottom: 16px;
      overflow: hidden;
    }
    .btn {
      padding: 10px 14px;
      border-radius: 10px;
      border: 2px solid var(--border-subtle);
      background-color: var(--bg-card);
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      text-decoration: none;
      font-size: 13.5px;
      max-width: 100%;
    }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-sm { padding: 6px 10px; font-size: 12.5px; }
    .btn-primary { background-color: var(--icon-primary); color: #FFFFFF; border-color: var(--icon-primary); }
    .btn-success { background-color: #16A34A; color: #FFF; border-color: #16A34A; }
    .btn-danger { background-color: #DC2626; color: #FFF; border-color: #DC2626; }
    .btn-warning { background-color: #D97706; color: #FFF; border-color: #D97706; }

    .host-board-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }
    .host-cat-box {
      background-color: var(--bg-canvas);
      border: 2px solid var(--border-subtle);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }
    .host-diff-btn { width: 100%; justify-content: space-between; padding: 8px 12px; }
    .host-diff-btn.is-active-slot { border-color: var(--icon-primary); background-color: var(--icon-container-bg); }

    .host-live-q-box {
      background-color: var(--icon-container-bg);
      border: 2px solid var(--icon-primary);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 14px;
    }

    .timeout-alert-box {
      background-color: var(--state-error-bg);
      border: 2px solid var(--state-error-border);
      color: var(--state-error-text);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 12px;
    }

    .referee-scores-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .referee-team-card {
      background-color: var(--bg-canvas);
      border: 2px solid var(--border-subtle);
      border-radius: 12px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
