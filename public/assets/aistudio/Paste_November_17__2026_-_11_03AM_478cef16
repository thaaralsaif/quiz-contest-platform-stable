    function toggleTeamInputsVisibility() {
      const count = Number(document.getElementById('set-team-count').value) || 4;
      for (let i = 1; i <= 8; i++) {
        const el = document.getElementById(`wrap-team-${i}`);
        if (el) el.classList.toggle('hidden', i > count);
