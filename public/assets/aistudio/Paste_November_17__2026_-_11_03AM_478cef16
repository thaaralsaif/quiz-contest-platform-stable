    function populateSettingsForm(settings) {
      if (!settings) return;
      document.getElementById('set-play-mode').value = settings.playMode || 'BOARD';
      document.getElementById('set-team-count').value = String(settings.teamCount || 4);
      for (let i = 1; i <= 8; i++) {
        const inp = document.getElementById(`set-team${i}`);
        if (inp) inp.value = settings[`team${i}Name`] || '';
      }
      toggleTeamInputsVisibility();
      document.getElementById('set-timer').value = String(settings.timerSeconds || 25);
      document.getElementById('set-answer-seconds').value = String(settings.answerSeconds || 7);
      document.getElementById('set-pts-easy').value = settings.pointsEasy || 100;
      document.getElementById('set-pts-medium').value = settings.pointsMedium || 200;
      document.getElementById('set-pts-hard').value = settings.pointsHard || 300;
      document.getElementById('set-points-wrong').value = settings.pointsWrongPenalty || 0;
      document.getElementById('set-font').value = settings.fontPair || 'cairo-almarai';

      const puEnabled = !(settings.powerUpsEnabled === false || String(settings.powerUpsEnabled) === 'false');
      document.getElementById('set-powerups-enabled').value = puEnabled ? 'true' : 'false';
      document.getElementById('set-pu-shield').value = settings.puShieldCount ?? 1;
      document.getElementById('set-pu-ai').value = settings.puAiCount ?? 1;
      document.getElementById('set-pu-double').value = settings.puDoubleCount ?? 1;
      document.getElementById('set-pu-freeze').value = settings.puFreezeCount ?? 1;
      document.getElementById('set-pu-steal').value = settings.puStealCount ?? 1;
      document.getElementById('set-pu-time').value = settings.puTimeCount ?? 1;
    }

    function saveSettingsForm() {
      const msgEl = document.getElementById('set-save-msg');
      msgEl.textContent = '⏳ جاري الحفظ...';
      const payload = {
        playMode: document.getElementById('set-play-mode').value,
        teamCount: Number(document.getElementById('set-team-count').value),
        timerSeconds: Number(document.getElementById('set-timer').value),
        answerSeconds: Number(document.getElementById('set-answer-seconds').value),
        pointsEasy: Number(document.getElementById('set-pts-easy').value),
        pointsMedium: Number(document.getElementById('set-pts-medium').value),
        pointsHard: Number(document.getElementById('set-pts-hard').value),
        pointsWrongPenalty: Number(document.getElementById('set-points-wrong').value),
        powerUpsEnabled: document.getElementById('set-powerups-enabled').value === 'true',
        puShieldCount: Number(document.getElementById('set-pu-shield').value),
        puAiCount: Number(document.getElementById('set-pu-ai').value),
        puDoubleCount: Number(document.getElementById('set-pu-double').value),
        puFreezeCount: Number(document.getElementById('set-pu-freeze').value),
        puStealCount: Number(document.getElementById('set-pu-steal').value),
        puTimeCount: Number(document.getElementById('set-pu-time').value),
        fontPair: document.getElementById('set-font').value
      };
      for (let i = 1; i <= 8; i++) {
        payload[`team${i}Name`] = document.getElementById(`set-team${i}`).value;
      }
      callServerWithRetry('saveGameSettings', [payload], (res) => {
        if (res && res.state) {
          applyIncomingState(res.state);
          msgEl.textContent = '✅ تم حفظ الإعدادات ورصيد الأدوات وتعميمها على الشاشات';
          setTimeout(() => { msgEl.textContent = ''; }, 3500);
        }
      });
    }

    function downloadExcelTemplate() {
      const sampleData = [
        ['الجولة', 'الفئة', 'الصعوبة', 'السؤال', 'الخيار A', 'الخيار B', 'الخيار C', 'الإجابة الصحيحة'],
        ['الجولة 1', 'علوم', 'سهل', 'ما هو الكوكب الأقرب إلى الشمس؟', 'عطارد', 'الزهرة', 'المريخ', 'A'],
        ['الجولة 1', 'علوم', 'متوسط', 'ما هو الرمز الكيميائي لعنصر الذهب؟', 'Ag', 'Au', 'Fe', 'B'],
        ['الجولة 1', 'علوم', 'صعب', 'كم يستغرق ضوء الشمس للوصول إلى الأرض تقريباً؟', '8 دقائق', 'ثانية واحدة', 'ساعة كاملة', 'A']
      ];
      const ws = XLSX.utils.aoa_to_sheet(sampleData);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Questions');
      XLSX.writeFile(wb, 'نموذج_أسئلة_الفئات_والصعوبات.xlsx');
    }

    function processExcelUpload() {
      const fileInput = document.getElementById('excel-file-input');
      const msgEl = document.getElementById('excel-import-msg');
      if (!fileInput.files || !fileInput.files[0]) {
        msgEl.textContent = '⚠️ اختر ملف Excel أو CSV أولاً';
        return;
      }
      msgEl.textContent = '⏳ جاري قراءة الملف ومعالجة الأسئلة...';
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });

          const parsedQuestions = [];
          rows.forEach((r, index) => {
            if (!r || r.length < 7) return;
            if (index === 0 && (String(r[0]).includes('الجولة') || String(r[0]).toLowerCase().includes('round'))) return;

            if (r.length >= 8) {
              parsedQuestions.push({
                round: String(r[0] || 'الجولة 1').trim(),
                category: String(r[1] || 'عام').trim(),
                difficulty: normalizeDifficulty(r[2]),
                question: String(r[3]).trim(),
                optA: String(r[4]).trim(),
                optB: String(r[5]).trim(),
                optC: String(r[6]).trim(),
                correct: String(r[7] || 'A').trim().toUpperCase()
              });
            } else {
              parsedQuestions.push({
                round: String(r[0] || 'الجولة 1').trim(),
                category: String(r[1] || 'عام').trim(),
                difficulty: ['سهل', 'متوسط', 'صعب'][index % 3],
                question: String(r[2]).trim(),
                optA: String(r[3]).trim(),
                optB: String(r[4]).trim(),
                optC: String(r[5]).trim(),
                correct: String(r[6] || 'A').trim().toUpperCase()
              });
            }
          });

          if (parsedQuestions.length === 0) {
            msgEl.textContent = '⚠️ لم يتم العثور على صفوف صالحة';
            return;
          }

          callServerWithRetry('bulkImportQuestions', [parsedQuestions], (res) => {
            if (res && res.status === 'OK') {
              msgEl.textContent = `✅ تم استيراد (${res.importedCount}) سؤال دفعة واحدة بنجاح!`;
              fileInput.value = '';
            }
          });
        } catch (err) {
          msgEl.textContent = '❌ تعذرت قراءة الملف؛ تأكد من سلامة الصيغة';
        }
      };
      reader.readAsArrayBuffer(fileInput.files[0]);
    }

    function hostApplyPreset(presetName) {
      document.documentElement.setAttribute('data-theme', presetName);
      CUSTOM_COLOR_FIELDS.forEach(f => document.documentElement.style.removeProperty(f.var));
      syncColorPickerInputs();
      callServerWithRetry('updateGameState', [{ activeTheme: presetName, customTokens: {} }]);
    }

    function renderColorPickers() {
      document.getElementById('host-color-pickers').innerHTML = CUSTOM_COLOR_FIELDS.map(f => `
        <div class="picker-item">
          <span>${f.label}</span>
          <input type="color" id="picker-${f.var}" onchange="hostUpdateCustomColor('${f.var}', this.value)">
        </div>
      `).join('');
    }

    function hostUpdateCustomColor(cssVar, hexValue) {
      document.documentElement.style.setProperty(cssVar, hexValue);
      const nextCustom = Object.assign({}, (appState && appState.customTokens) || {}, { [cssVar]: hexValue });
      callServerWithRetry('updateGameState', [{ customTokens: nextCustom }]);
    }

    function hostResetCustomColors() {
      const currentTheme = (appState && appState.activeTheme) || 'luxury';
      hostApplyPreset(currentTheme);
    }

    function submitNewQuestion() {
      const msgEl = document.getElementById('new-q-msg');
      const qData = {
        round: document.getElementById('new-q-round').value.trim() || 'الجولة 1',
        category: document.getElementById('new-q-cat').value.trim() || 'عام',
        difficulty: document.getElementById('new-q-diff').value,
        question: document.getElementById('new-q-text').value.trim(),
        optA: document.getElementById('new-q-a').value.trim(),
        optB: document.getElementById('new-q-b').value.trim(),
        optC: document.getElementById('new-q-c').value.trim(),
        correct: document.getElementById('new-q-correct').value
      };
      if (!qData.question || !qData.optA || !qData.optB || !qData.optC) {
        msgEl.textContent = '⚠️ أكمل نص السؤال وجميع الخيارات الثلاثة';
        return;
      }
      msgEl.textContent = '⏳ جاري الإضافة...';
      callServerWithRetry('addQuestionToSheet', [qData], () => {
        msgEl.textContent = '✅ تمت إضافة السؤال بنجاح';
        document.getElementById('new-q-text').value = '';
        document.getElementById('new-q-a').value = '';
        document.getElementById('new-q-b').value = '';
        document.getElementById('new-q-c').value = '';
        setTimeout(() => { msgEl.textContent = ''; }, 3000);
      });
    }

    function renderQRLinks(state) {
      const count = Number(state.settings && state.settings.teamCount) || 4;
      const screens = [
        { title: 'شاشة العرض الكبرى (TV)', url: `${BASE_URL}?view=tv` },
        { title: 'استوديو الإعدادات وإكسل', url: `${BASE_URL}?view=settings` }
      ];
      for (let i = 1; i <= count; i++) {
        screens.push({
          title: `فريق ${i}: ${getTeamName(String(i), state.settings)}`,
          url: `${BASE_URL}?view=mobile&team=${i}`
        });
      }
      document.getElementById('host-qr-container').innerHTML = screens.map(s => `
        <div class="qr-card">
          <div style="font-weight:800; font-size:13.5px;">${escapeHTML(s.title)}</div>
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=135x135&data=${encodeURIComponent(s.url)}" alt="QR" width="135" height="135">
          <a href="${s.url}" target="_blank" class="btn" style="font-size:12px; width:100%;">فتح الشاشة</a>
        </div>
      `).join('');
    }

    function getRankedTeams(state) {
      const count = Number(state.settings && state.settings.teamCount) || 4;
      const eliminated = state.eliminatedTeams || [];
      const list = [];
      for (let i = 1; i <= count; i++) {
        const id = String(i);
        list.push({
          id: id,
          name: getTeamName(id, state.settings),
          score: Number((state.scores && state.scores[id]) || 0),
          eliminated: eliminated.includes(id)
        });
      }
      return list.sort((a, b) => b.score - a.score);
    }

    function exportMatchPDF() {
      if (!appState) return;
      const ranked = getRankedTeams(appState);
      const dateStr = new Date().toLocaleString('ar-SA');
      document.getElementById('printable-report-area').innerHTML = `
        <div style="border-bottom: 3px solid #0F172A; padding-bottom: 16px; margin-bottom: 20px;">
          <h1 style="font-size: 26px; margin-bottom: 6px;">التقرير الرسمي لنتائج بطولة النخبة الكبرى للمسابقات</h1>
          <p style="color: #475569; font-size: 14px;">تاريخ وتوقيت الإصدار: ${dateStr}</p>
        </div>
        <table class="report-table">
          <thead>
            <tr><th>المركز</th><th>اسم الفريق</th><th>مجموع النقاط</th><th>حالة التأهل</th></tr>
          </thead>
          <tbody>
            ${ranked.map((t, idx) => `
              <tr>
                <td><strong>#${idx + 1}</strong></td>
                <td>${escapeHTML(t.name)}</td>
                <td><strong>${t.score} نقطة</strong></td>
                <td>${t.eliminated ? 'مُقصى في جولة التصفية' : 'متأهل / نشط'}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
      window.print();
    }

    function startConfetti() {
      if (confettiAnimId) return;
      const canvas = document.getElementById('confetti-canvas');
      canvas.classList.remove('hidden');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const pieces = Array.from({ length: 110 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        w: Math.random() * 10 + 6,
        h: Math.random() * 6 + 4,
        color: TEAM_COLORS[Math.floor(Math.random() * TEAM_COLORS.length)],
        speedY: Math.random() * 3 + 2,
        speedX: Math.random() * 2 - 1,
        angle: Math.random() * 360
      }));

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.y += p.speedY;
          p.x += p.speedX;
          p.angle += 4;
          if (p.y > canvas.height) { p.y = -10; p.x = Math.random() * canvas.width; }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.angle * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });
        confettiAnimId = requestAnimationFrame(draw);
      }
      draw();
    }

    function stopConfetti() {
      if (confettiAnimId) {
        cancelAnimationFrame(confettiAnimId);
        confettiAnimId = null;
        document.getElementById('confetti-canvas').classList.add('hidden');
      }
    }

    function escapeHTML(str) {
      return String(str).replace(/[&<>"']/g, m => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
    }
    function escapeAttr(str) {
      return String(str).replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }
  </script>
