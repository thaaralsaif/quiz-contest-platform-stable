  <!-- ========================================================================
       5. محرك المنطق، إعادة المحاولة التلقائية عند انشغال القفل، والمزامنة الحية
       ======================================================================== -->
  <script>
    const INITIAL_VIEW = "<?= view ?>";
    const TEAM_ID = "<?= teamId ?>";
    const BASE_URL = "<?= scriptUrl ?>";

    const TEAM_COLORS = ['#0284C7', '#D97706', '#DB2777', '#16A34A', '#9333EA', '#EA580C', '#0D9488', '#4F46E5'];
    const DIFFICULTY_LEVELS = ['سهل', 'متوسط', 'صعب'];

    const CUSTOM_COLOR_FIELDS = [
      { var: '--bg-canvas', label: 'خلفية الشاشة العامة' },
      { var: '--bg-card', label: 'خلفية البطاقات والصناديق' },
      { var: '--text-primary', label: 'لون الخط الأساسي' },
      { var: '--text-secondary', label: 'لون الخط الفرعي' },
      { var: '--icon-container-bg', label: 'خلفية الأيقونات والوسوم' },
      { var: '--icon-primary', label: 'لون الأيقونات' },
      { var: '--buzzer-bg', label: 'خلفية زر الضاغط' },
      { var: '--buzzer-text', label: 'خط وأيقونة الضاغط' }
    ];

    let appState = null;
    let questionsBank = [];
    let questionsLoaded = false;
    let knownQuestionsVersion = 0;

    let isPolling = false;
    let latestAppliedRevision = 0;
    let localBuzzerLock = false;
    let boardSlotActionLock = false;
    let autoTransitionLock = false;
    let answerTimeoutLock = false;
    let answerTimeoutTriggeredRev = -1;
    let serverTimeOffset = 0;
    let settingsInitialized = false;

    let lastHostBoardSig = '';
    let lastTvBoardSig = '';
    let lastTvTeamsSig = '';
    let lastTvQuestionSig = '';
    let lastRenderedTeamCount = 0;
    let lastRefereeScoresSig = '';

    let audioCtx = null;
    let soundEnabled = false;
    let lastSoundState = '';
    let lastPowerUpBanner = '';
    let lastTickSecond = -1;
    let confettiAnimId = null;

    window.addEventListener('DOMContentLoaded', () => {
      const targetView = document.getElementById(`view-${INITIAL_VIEW}`) ? INITIAL_VIEW : 'host';
      document.getElementById(`view-${targetView}`).classList.remove('hidden');

      if (targetView === 'mobile') {
        document.getElementById('mob-team-num').textContent = TEAM_ID;
      }
      if (targetView === 'host' || targetView === 'tv') {
        loadQuestionsFromSheet();
      }
      if (targetView === 'settings') {
        buildTeamNameInputs();
        renderColorPickers();
      }

      fetchState(true);
      setInterval(() => fetchState(false), 1000);
      setInterval(updateSyncedTimersUI, 250);
    });

    function showToast(msg) {
      const el = document.getElementById('global-toast');
      if (!el || !msg) return;
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(el._timer);
      el._timer = setTimeout(() => el.classList.add('hidden'), 3200);
    }

    // دالة استدعاء الخادم مع إعادة المحاولة التلقائية عند انشغال القفل (BUSY)
    function callServerWithRetry(methodName, args, onSuccess, onFailure, maxRetries = 3) {
      let attempt = 0;
      function execute() {
        attempt++;
        const runner = google.script.run
          .withSuccessHandler((res) => {
            if (res && res.status === 'BUSY' && attempt < maxRetries) {
              setTimeout(execute, 400 * attempt);
              return;
            }
            if (onSuccess) onSuccess(res);
          })
          .withFailureHandler((err) => {
            if (attempt < maxRetries) {
              setTimeout(execute, 400 * attempt);
              return;
            }
            if (onFailure) onFailure(err);
          });
        runner[methodName].apply(runner, args || []);
      }
      execute();
    }

    function normalizeDifficulty(rawDiff) {
      const d = String(rawDiff || '').trim().toLowerCase();
      if (d === 'صعب' || d === 'صعبة' || d === 'hard' || d === '3') return 'صعب';
      if (d === 'متوسط' || d === 'متوسطة' || d === 'medium' || d === '2') return 'متوسط';
      return 'سهل';
    }

    // 1. الصوت البرمجي
    function toggleTVAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      soundEnabled = !soundEnabled;
      document.getElementById('tv-sound-toggle').textContent = soundEnabled ? '🔊 الصوت: مفعّل' : '🔇 تفعيل الصوت';
      if (soundEnabled) playTone(660, 0.12, 'sine');
    }

    function playTone(freq, duration, type = 'sine', delay = 0) {
      if (!soundEnabled || !audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime + delay);
      gain.gain.setValueAtTime(0.18, audioCtx.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + delay + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(audioCtx.currentTime + delay);
      osc.stop(audioCtx.currentTime + delay + duration);
    }

    function triggerStateSounds(state) {
      if (INITIAL_VIEW !== 'tv' || !soundEnabled) return;
      const sig = `${state.fsmState}_${state.lockedTeamId || ''}_${state.timedOutTeamId || ''}_${state.lastEliminatedTeam || ''}`;
      if (sig !== lastSoundState) {
        lastSoundState = sig;
        if (state.fsmState === 'BUZZER_LOCKED') {
          playTone(523.25, 0.12, 'triangle', 0);
          playTone(783.99, 0.25, 'triangle', 0.1);
        } else if (state.fsmState === 'ANSWER_CORRECT') {
          playTone(523.25, 0.15, 'sine', 0);
          playTone(659.25, 0.15, 'sine', 0.12);
          playTone(1046.5, 0.35, 'sine', 0.24);
        } else if (state.fsmState === 'ANSWER_WRONG' || state.fsmState === 'ANSWER_TIMEOUT') {
          playTone(180, 0.35, 'sawtooth', 0);
        } else if (state.fsmState === 'CELEBRATION_PODIUM') {
          [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((f, idx) => playTone(f, 0.28, 'triangle', idx * 0.13));
        }
      }

      const puBanner = (state.activeEffects && state.activeEffects.lastPowerUpBanner) || '';
      if (puBanner && puBanner !== lastPowerUpBanner) {
        lastPowerUpBanner = puBanner;
        playTone(440, 0.1, 'sine', 0);
        playTone(880, 0.18, 'sine', 0.09);
      }
    }

    // 2. جلب الحالة الحية مع إيقاف الاستطلاع الدوري في شاشة المذيع على لوحة الفئات (Zero-Polling on Board)
    function fetchState(forceNow) {
      if (isPolling) return;

      if (!forceNow && INITIAL_VIEW === 'host' && appState) {
        const isBoardIdle = (appState.fsmState === 'CATEGORY_BOARD' && !appState.autoTransitionAction);
        if (isBoardIdle) {
          return;
        }
      }

      isPolling = true;
      const revisionAtSend = latestAppliedRevision;

      google.script.run
        .withSuccessHandler((state) => {
          isPolling = false;
          if (!state) return;
          const incomingRev = Number(state.stateRevision) || 0;
          if (incomingRev < latestAppliedRevision || incomingRev < revisionAtSend) {
            return;
          }
          applyIncomingState(state);
        })
        .withFailureHandler(() => { isPolling = false; })
        .getGameState();
    }

    function manualHostRefresh() {
      showToast('⏳ جاري مزامنة الحالة...');
      fetchState(true);
    }

    function syncQuestionsList(list) {
      questionsBank = list || [];
      questionsLoaded = true;
      lastHostBoardSig = '';
      lastTvBoardSig = '';

      if (INITIAL_VIEW === 'host') {
        const rounds = [...new Set(questionsBank.map(q => q.round || 'الجولة 1'))];
        const rSelect = document.getElementById('host-round-filter');
        const desiredVal = (appState && appState.selectedRound) || 'ALL';
        rSelect.innerHTML = `<option value="ALL">جميع الجولات (${questionsBank.length})</option>` +
          rounds.map(r => `<option value="${escapeAttr(r)}">${escapeHTML(r)}</option>`).join('');
        rSelect.value = (desiredVal === 'ALL' || rounds.includes(desiredVal)) ? desiredVal : 'ALL';
        filterQuestionsDropdown();
      }
    }

    function applyIncomingState(state, freshQuestionsList) {
      const incomingRev = Number(state.stateRevision) || 0;
      if (incomingRev > latestAppliedRevision) {
        latestAppliedRevision = incomingRev;
      }
      if (state.serverNow) serverTimeOffset = state.serverNow - Date.now();

      appState = state;
      const srvVer = Number(state.questionsVersion) || 1;

      if (Array.isArray(freshQuestionsList)) {
        knownQuestionsVersion = srvVer;
        syncQuestionsList(freshQuestionsList);
      } else if ((INITIAL_VIEW === 'host' || INITIAL_VIEW === 'tv') && srvVer !== knownQuestionsVersion) {
        knownQuestionsVersion = srvVer;
        loadQuestionsFromSheet();
      }

      applyThemeAndFonts(state);
      triggerStateSounds(state);
      renderCurrentView(state);
    }

    // 3. تطبيق الثيم والخطوط ومزامنة مربعات الألوان
    function applyThemeAndFonts(state) {
      const themeName = state.activeTheme || 'luxury';
      const fontPair = (state.settings && state.settings.fontPair) || 'cairo-almarai';

      if (document.documentElement.getAttribute('data-theme') !== themeName) {
        document.documentElement.setAttribute('data-theme', themeName);
      }
      if (document.documentElement.getAttribute('data-font') !== fontPair) {
        document.documentElement.setAttribute('data-font', fontPair);
      }

      CUSTOM_COLOR_FIELDS.forEach(f => document.documentElement.style.removeProperty(f.var));
      if (state.customTokens && typeof state.customTokens === 'object') {
        Object.entries(state.customTokens).forEach(([cssVar, val]) => {
          if (val) document.documentElement.style.setProperty(cssVar, val);
        });
      }

      if (INITIAL_VIEW === 'settings') {
        document.querySelectorAll('.theme-card-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.preset === themeName);
        });
        syncColorPickerInputs();
      }
    }

    function rgbToHex(rgbStr) {
      if (!rgbStr) return '#000000';
      if (rgbStr.startsWith('#')) return rgbStr.length === 7 ? rgbStr : '#000000';
      const match = rgbStr.match(/\d+/g);
      if (!match || match.length < 3) return '#000000';
      return '#' + match.slice(0, 3).map(x => Number(x).toString(16).padStart(2, '0')).join('');
    }

    function syncColorPickerInputs() {
      const computed = getComputedStyle(document.documentElement);
      CUSTOM_COLOR_FIELDS.forEach(f => {
        const inputEl = document.getElementById(`picker-${f.var}`);
        if (inputEl) inputEl.value = rgbToHex(computed.getPropertyValue(f.var).trim());
      });
    }

    // 4. تحديث المؤقتين (مؤقت السؤال + مؤقت الإجابة الفورية < 10 ثوانٍ) وتنفيذ الانتقال المجدول
    function updateSyncedTimersUI() {
      if (!appState) return;
      const syncedNow = Date.now() + serverTimeOffset;

      if (INITIAL_VIEW === 'host' && appState.autoTransitionAction && appState.autoTransitionAt) {
        if (syncedNow >= appState.autoTransitionAt && !autoTransitionLock) {
          autoTransitionLock = true;
          google.script.run.withSuccessHandler((res) => {
            autoTransitionLock = false;
            if (res && res.state) applyIncomingState(res.state);
          }).withFailureHandler(() => { autoTransitionLock = false; }).executeScheduledTransition();
        }
      }

      const tvTimer = document.getElementById('tv-timer');
      const tvTimerTitle = document.getElementById('tv-timer-title');
      const hostTimer = document.getElementById('host-timer');
      const mobTimer = document.getElementById('mob-timer');
      const tvAnsPill = document.getElementById('tv-answer-timer-box');

      // المرحلة الثانية: مؤقت الإجابة الفورية (< 10 ثوانٍ) عند قفل الضاغط (BUZZER_LOCKED)
      if (appState.fsmState === 'BUZZER_LOCKED') {
        const ansDefault = Number(appState.settings && appState.settings.answerSeconds) || 7;
        let ansRem = Number(appState.pausedAnswerRemaining) || ansDefault;
        if (!appState.isTimerPaused && appState.answerEndTime) {
          ansRem = Math.max(0, Math.ceil((appState.answerEndTime - syncedNow) / 1000));
        }

        const ansFormatted = appState.isTimerPaused ? `⏸️ ${ansRem}s` : `00:0${ansRem}`;
        if (tvTimerTitle) tvTimerTitle.textContent = 'مهلة الإجابة الفورية';
        if (tvTimer) {
          tvTimer.textContent = ansFormatted;
          tvTimer.classList.add('timer-urgent');
        }
        if (tvAnsPill) {
          tvAnsPill.classList.remove('hidden');
          const holderName = getTeamName(appState.lockedTeamId, appState.settings);
          tvAnsPill.textContent = appState.isTimerPaused
            ? `⏸️ المؤقت متوقف — (${holderName}): ${ansRem} ثوانٍ`
            : `⏳ مهلة الإجابة (${holderName}): ${ansRem} ثوانٍ`;
        }
        if (hostTimer) {
          hostTimer.textContent = appState.isTimerPaused ? `⏸️ إجابة: ${ansRem}ث` : `⏳ إجابة: 00:0${ansRem}`;
          hostTimer.style.color = '#DC2626';
        }
        if (mobTimer) {
          mobTimer.textContent = appState.isTimerPaused ? `⏸️ ${ansRem}s` : `⏳ إجابة: ${ansRem}s`;
          mobTimer.style.color = '#DC2626';
        }

        if (INITIAL_VIEW === 'tv' && soundEnabled && !appState.isTimerPaused && ansRem <= 3 && ansRem > 0 && ansRem !== lastTickSecond) {
          lastTickSecond = ansRem;
          playTone(980, 0.08, 'sine');
        }

        // إطلاق انتهاء وقت الإجابة تلقائياً عند وصول العداد إلى 0
        if (!appState.isTimerPaused && appState.answerEndTime && syncedNow >= appState.answerEndTime) {
          if ((INITIAL_VIEW === 'host' || INITIAL_VIEW === 'tv') && !answerTimeoutLock && answerTimeoutTriggeredRev !== appState.stateRevision) {
            answerTimeoutLock = true;
            answerTimeoutTriggeredRev = appState.stateRevision;
            google.script.run
              .withSuccessHandler((res) => {
                answerTimeoutLock = false;
                if (res && res.state) applyIncomingState(res.state);
              })
              .withFailureHandler(() => { answerTimeoutLock = false; })
              .triggerAnswerTimeout();
          }
        }
        return;
      }

      // إخفاء شارة عداد الإجابة خارج حالة BUZZER_LOCKED
      if (tvAnsPill) tvAnsPill.classList.add('hidden');
      if (tvTimerTitle) tvTimerTitle.textContent = 'المؤقت المسرحي';
      if (hostTimer) hostTimer.style.color = 'var(--icon-primary)';
      if (mobTimer) mobTimer.style.color = 'var(--icon-primary)';

      // المرحلة الأولى: مؤقت قراءة السؤال والتسابق (QUESTION_ACTIVE)
      let rem = Number(appState.pausedRemaining) || (appState.settings ? appState.settings.timerSeconds : 25);
      if (appState.fsmState === 'QUESTION_ACTIVE' && !appState.isTimerPaused && appState.questionEndTime) {
        rem = Math.max(0, Math.ceil((appState.questionEndTime - syncedNow) / 1000));
        if (INITIAL_VIEW === 'tv' && soundEnabled && rem <= 5 && rem > 0 && rem !== lastTickSecond) {
          lastTickSecond = rem;
          playTone(880, 0.08, 'sine');
        }
      }

      const formatted = appState.isTimerPaused && appState.fsmState === 'QUESTION_ACTIVE'
        ? `⏸️ 00:${String(rem).padStart(2, '0')}`
        : `00:${String(rem).padStart(2, '0')}`;

      if (tvTimer) {
        tvTimer.textContent = formatted;
        tvTimer.classList.toggle('timer-urgent', appState.fsmState === 'QUESTION_ACTIVE' && !appState.isTimerPaused && rem <= 5);
      }
      if (hostTimer) hostTimer.textContent = formatted;
      if (mobTimer) mobTimer.textContent = appState.isTimerPaused ? `⏸️ ${rem}s` : `⏱ ${rem}s`;
    }

    function getTeamName(id, settings) {
      if (!settings) return `فريق ${id}`;
      return settings[`team${id}Name`] || `فريق ${id}`;
    }

    function getDifficultyPoints(diff, settings) {
      const d = normalizeDifficulty(diff);
      if (!settings) return 100;
      if (d === 'صعب') return Number(settings.pointsHard) || 300;
      if (d === 'متوسط') return Number(settings.pointsMedium) || 200;
      return Number(settings.pointsEasy) || 100;
    }

    function buildCategoryMatrix(usedIds, selectedRound) {
      const usedSet = new Set((usedIds || []).map(Number));
      const roundFilter = String(selectedRound || 'ALL').trim();
      const categoriesMap = {};

      questionsBank.forEach(q => {
        if (roundFilter !== 'ALL' && String(q.round || 'الجولة 1').trim() !== roundFilter) return;
        const cat = String(q.category || 'عام').trim();
        const diff = normalizeDifficulty(q.difficulty);
        if (!categoriesMap[cat]) {
          categoriesMap[cat] = { 'سهل': 0, 'متوسط': 0, 'صعب': 0 };
        }
        if (!usedSet.has(Number(q.id))) {
          categoriesMap[cat][diff]++;
        }
      });
      return categoriesMap;
    }

    // 5. رسم الشاشات
    function renderCurrentView(state) {
      if (INITIAL_VIEW === 'tv') renderTVView(state);
      if (INITIAL_VIEW === 'mobile') renderMobileView(state);
      if (INITIAL_VIEW === 'host') renderHostView(state);
      if (INITIAL_VIEW === 'settings' && !settingsInitialized) {
        populateSettingsForm(state.settings);
        settingsInitialized = true;
      }
    }

    function renderTVView(state) {
      const teamCount = Number(state.settings && state.settings.teamCount) || 4;
      const eliminated = state.eliminatedTeams || [];
      const activeTurnId = String(state.activeTurnTeamId || '1');
      document.getElementById('tv-round-badge').textContent = state.currentRoundLabel || 'جميع الجولات';

      // إعلان قرارات المذيع التحكيمية بشفافية على شاشة الجمهور
      const refBannerEl = document.getElementById('tv-referee-banner');
      const nowMs = Date.now() + serverTimeOffset;
      if (state.refereeNotice && state.refereeNotice.text && (nowMs - Number(state.refereeNotice.at || 0) < 14000)) {
        refBannerEl.textContent = state.refereeNotice.text;
        refBannerEl.classList.remove('hidden');
      } else {
        refBannerEl.classList.add('hidden');
      }

      const puBannerEl = document.getElementById('tv-powerup-banner');
      if (state.lastStealSummary && state.fsmState === 'ANSWER_CORRECT') {
        const st = state.lastStealSummary;
        puBannerEl.textContent = `🧲 تمت سرقة +${st.amount} نقطة من (${st.victimName}) لصالح (${st.thiefName})!`;
        puBannerEl.classList.remove('hidden');
      } else if (state.activeEffects && state.activeEffects.lastPowerUpBanner && ['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState)) {
        puBannerEl.textContent = state.activeEffects.lastPowerUpBanner;
        puBannerEl.classList.remove('hidden');
      } else {
        puBannerEl.classList.add('hidden');
      }

      const teamsSig = JSON.stringify({
        teamCount,
        eliminated,
        turn: state.fsmState === 'CATEGORY_BOARD' ? activeTurnId : '',
        scores: state.scores,
        names: Array.from({ length: teamCount }, (_, i) => getTeamName(String(i + 1), state.settings))
      });
      if (teamsSig !== lastTvTeamsSig) {
        lastTvTeamsSig = teamsSig;
        const teamsBar = document.getElementById('tv-teams-bar');
        let teamsHTML = '';
        for (let i = 1; i <= teamCount; i++) {
          const id = String(i);
          const isElim = eliminated.includes(id);
          const isTurn = (state.fsmState === 'CATEGORY_BOARD' && id === activeTurnId && !isElim);
          const score = (state.scores && state.scores[id]) || 0;
          teamsHTML += `
            <div class="team-card ${isElim ? 'is-eliminated' : ''} ${isTurn ? 'is-active-turn' : ''}">
              <div class="team-rank" style="background:${TEAM_COLORS[i - 1]};">${i}</div>
              <div style="overflow:hidden; min-width:0;">
                <div style="font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:14px;">
                  ${isTurn ? '🎯 ' : ''}${escapeHTML(getTeamName(id, state.settings))}
                </div>
                <div style="color:var(--icon-primary); font-weight:800; font-size:13px;">
                  ${isElim ? '❌ مُقصى' : `${score} نقطة`}
                </div>
              </div>
            </div>
          `;
        }
        teamsBar.innerHTML = teamsHTML;
      }

      const boardEl = document.getElementById('tv-board-state');
      const lobbyEl = document.getElementById('tv-lobby-state');
      const qBoxEl = document.getElementById('tv-question-state');
      const podiumEl = document.getElementById('tv-podium-state');
      const bannerEl = document.getElementById('tv-buzzer-banner');

      boardEl.classList.add('hidden');
      lobbyEl.classList.add('hidden');
      qBoxEl.classList.add('hidden');
      podiumEl.classList.add('hidden');

      if (state.fsmState === 'CELEBRATION_PODIUM') {
        podiumEl.classList.remove('hidden');
        renderPodiumCards(state);
        startConfetti();
        return;
      } else {
        stopConfetti();
      }

      if (state.fsmState === 'CATEGORY_BOARD') {
        boardEl.classList.remove('hidden');
        document.getElementById('tv-turn-team-name').textContent = getTeamName(activeTurnId, state.settings);

        const noticeEl = document.getElementById('tv-board-notice');
        if (state.boardNotice) {
          noticeEl.textContent = state.boardNotice;
          noticeEl.classList.remove('hidden');
        } else {
          noticeEl.classList.add('hidden');
        }

        const matrix = buildCategoryMatrix(state.usedQuestionIds, state.selectedRound);
        const tvBoardSig = JSON.stringify({
          loaded: questionsLoaded,
          matrix,
          pts: [state.settings.pointsEasy, state.settings.pointsMedium, state.settings.pointsHard]
        });

        if (tvBoardSig !== lastTvBoardSig) {
          lastTvBoardSig = tvBoardSig;
          const catNames = Object.keys(matrix);
          document.getElementById('tv-categories-grid').innerHTML = catNames.length
            ? catNames.map(cat => `
                <div class="cat-column-card">
                  <div class="cat-column-title">${escapeHTML(cat)}</div>
                  ${DIFFICULTY_LEVELS.map(diff => {
                    const remCount = matrix[cat][diff] || 0;
                    const pts = getDifficultyPoints(diff, state.settings);
                    return `
                      <div class="diff-slot-tile ${remCount === 0 ? 'is-empty' : ''}">
                        <span>${diff} <small style="color:var(--text-secondary);">(${remCount})</small></span>
                        <span class="diff-pts-badge">${pts} نقطة</span>
                      </div>
                    `;
                  }).join('')}
                </div>
              `).join('')
            : '<p style="font-weight:800; color:var(--text-secondary);">جاري تجهيز لوحة الفئات...</p>';
        }
        return;
      }

      if (state.fsmState === 'WAITING_LOBBY' || !state.currentQuestion) {
        lobbyEl.classList.remove('hidden');
        const subEl = document.getElementById('tv-lobby-sub');
        if (state.lastEliminatedTeam) {
          subEl.textContent = `⚔️ نتيجة جولة التصفية: تم إقصاء (${getTeamName(state.lastEliminatedTeam, state.settings)}) بأقل رصيد نقاط!`;
        } else {
          subEl.textContent = 'شاشة العرض الكبرى جاهزة ومزامنة لحظياً مع غرفة القيادة وأجهزة المتسابقين.';
        }
        return;
      }

      qBoxEl.classList.remove('hidden');
      const q = state.currentQuestion;
      const ptsValue = state.currentQuestionPoints || getDifficultyPoints(q.difficulty, state.settings);
      const elimOpts = (state.activeEffects && state.activeEffects.eliminatedOptions) || [];
      const tvQSig = JSON.stringify({ id: q.id, fsm: state.fsmState, elimOpts, ptsValue });

      if (tvQSig !== lastTvQuestionSig) {
        lastTvQuestionSig = tvQSig;
        document.getElementById('tv-q-category').textContent = `${q.category} • مستوى ${q.difficulty || 'سهل'} (${ptsValue} نقطة)`;
        document.getElementById('tv-q-text').textContent = q.question;

        document.getElementById('tv-q-options').innerHTML = ['A', 'B', 'C'].map(letter => {
          const isCorrectClass = (state.fsmState === 'ANSWER_CORRECT' && q.correct === letter) ? 'is-correct' : '';
          const isElimClass = elimOpts.includes(letter) ? 'is-eliminated' : '';
          return `
            <div class="option-card ${isCorrectClass} ${isElimClass}">
              <span class="option-letter">${letter}</span>
              <span>${escapeHTML(q.options[letter])}</span>
            </div>
          `;
        }).join('');
      }

      const eff = state.activeEffects || {};
      if (state.fsmState === 'ANSWER_TIMEOUT') {
        bannerEl.classList.remove('hidden');
        bannerEl.textContent = `⏰ انتهى وقت الإجابة الفورية لفريق (${getTeamName(state.timedOutTeamId, state.settings)})! بانتظار قرار المذيع...`;
      } else if (state.lockedTeamId) {
        bannerEl.classList.remove('hidden');
        const holder = state.lockedTeamId;
        const tName = getTeamName(holder, state.settings);
        const hasDouble = (eff.doubleTeams || []).includes(holder) || eff.doubleTeam === holder;
        const stealTarget = (eff.stealTargets && eff.stealTargets[holder]) || (eff.stealTeam === holder ? 'LEADING' : null);
        const hasShield = (eff.shieldTeams || []).includes(holder) || eff.shieldTeam === holder;
        const badges = [
          hasDouble ? '🚀 مضاعفة ×2' : '',
          stealTarget ? `🧲 سرقة${stealTarget !== 'LEADING' ? ' من ' + getTeamName(stealTarget, state.settings) : ' نقاط'}` : '',
          hasShield ? '🛡️ درع حماية' : ''
        ].filter(Boolean).join(' | ');
        const badgeTxt = badges ? ` [${badges}]` : '';

        if (state.fsmState === 'ANSWER_CORRECT') {
          bannerEl.textContent = `✅ إجابة صحيحة لصالح: ${tName}${badgeTxt} (+${ptsValue} نقطة)`;
        } else if (state.fsmState === 'ANSWER_WRONG') {
          bannerEl.textContent = `❌ إجابة خاطئة من: ${tName}${hasShield ? ' (درع الحماية منع الخصم!)' : ''}`;
        } else {
          bannerEl.textContent = `⚡ الأسرع بالضغط: ${tName}${badgeTxt}`;
        }
      } else {
        const activeFrozenIds = Object.keys(eff.frozenTeams || {}).filter(id => Number(eff.frozenTeams[id]) > nowMs);
        if (activeFrozenIds.length > 0) {
          bannerEl.classList.remove('hidden');
          bannerEl.textContent = `❄️ ضاغط مجمد لـ (${activeFrozenIds.map(id => getTeamName(id, state.settings)).join(' ، ')})!`;
        } else if (eff.freezeTargetTeam && nowMs < eff.freezeUntil) {
          bannerEl.classList.remove('hidden');
          bannerEl.textContent = `❄️ تم تجميد ضاغط (${getTeamName(eff.freezeTargetTeam, state.settings)}) لـ 8 ثوانٍ!`;
        } else {
          bannerEl.classList.add('hidden');
        }
      }
    }

    function renderPodiumCards(state) {
      const ranked = getRankedTeams(state).slice(0, 3);
      const medals = ['🥇 المركز الأول', '🥈 المركز الثاني', '🥉 المركز الثالث'];
      document.getElementById('tv-podium-cards').innerHTML = ranked.map((t, idx) => `
        <div class="podium-step podium-${idx + 1}">
          <div style="font-size:17px; font-weight:900; margin-bottom:8px;">${medals[idx]}</div>
          <h2 class="font-display" style="font-size:22px; margin-bottom:6px;">${escapeHTML(t.name)}</h2>
          <div style="font-size:24px; font-weight:900; color:var(--icon-primary);">${t.score} نقطة</div>
        </div>
      `).join('');
    }

    function getEligibleStealVictims(state, myTeamId) {
      const count = Number(state.settings && state.settings.teamCount) || 4;
      const eliminated = state.eliminatedTeams || [];
      const list = [];
      for (let i = 1; i <= count; i++) {
        const id = String(i);
        if (id === String(myTeamId)) continue;
        if (eliminated.includes(id)) continue;
        const sc = Number((state.scores && state.scores[id]) || 0);
        if (sc > 0) {
          list.push({ id, name: getTeamName(id, state.settings), score: sc });
        }
      }
      return list;
    }

    function renderMobileView(state) {
      const tId = String(TEAM_ID);
      const eliminated = state.eliminatedTeams || [];
      const isElim = eliminated.includes(tId);
      const isAttempted = (state.attemptedTeamsThisQuestion || []).includes(tId);
      const syncedNow = Date.now() + serverTimeOffset;
      const eff = state.activeEffects || {};
      const freezeMapEnd = (eff.frozenTeams && Number(eff.frozenTeams[tId])) || 0;
      const isFrozen = (freezeMapEnd > syncedNow) || (eff.freezeTargetTeam === tId && syncedNow < eff.freezeUntil);
      const isQuestionLive = ['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState);
      const puEnabled = !(state.settings && (state.settings.powerUpsEnabled === false || String(state.settings.powerUpsEnabled) === 'false'));

      document.getElementById('mob-team-name').textContent = getTeamName(tId, state.settings);
      document.getElementById('mob-score').textContent = (state.scores && state.scores[tId]) || 0;

      const puGrid = document.getElementById('mob-powerups-grid');
      const puDisabledMsg = document.getElementById('mob-powerups-disabled-msg');
      if (!puEnabled) {
        if (puGrid) puGrid.classList.add('hidden');
        if (puDisabledMsg) puDisabledMsg.classList.remove('hidden');
      } else {
        if (puGrid) puGrid.classList.remove('hidden');
        if (puDisabledMsg) puDisabledMsg.classList.add('hidden');
      }

      const eligibleVictims = getEligibleStealVictims(state, tId);
      const hasShield = (eff.shieldTeams || []).includes(tId) || eff.shieldTeam === tId;
      const hasDouble = (eff.doubleTeams || []).includes(tId) || eff.doubleTeam === tId;
      const stealTargetId = (eff.stealTargets && eff.stealTargets[tId]) || (eff.stealTeam === tId ? 'ACTIVE' : null);

      const teamPU = (state.powerUps && state.powerUps[tId]) || {};
      ['shield', 'ai', 'double', 'freeze', 'steal', 'time'].forEach(key => {
        const btnEl = document.getElementById(`pu-${key}`);
        const badgeEl = document.getElementById(`pu-count-${key}`);
        const remCount = Number(teamPU[key]) || 0;
        if (badgeEl) badgeEl.textContent = remCount;

        let blocked = !puEnabled || isElim || !isQuestionLive || remCount <= 0;
        if (key === 'shield' && hasShield) blocked = true;
        if (key === 'double' && hasDouble) blocked = true;
        if (key === 'steal' && (stealTargetId || eligibleVictims.length === 0)) blocked = true;
        if (state.fsmState === 'BUZZER_LOCKED') {
          if (['freeze', 'time'].includes(key)) blocked = true;
          if (String(state.lockedTeamId) !== tId) blocked = true;
        }
        if (btnEl) btnEl.disabled = blocked;
      });

      const buffEl = document.getElementById('mob-active-buff');
      const buffs = [];
      if (hasShield) buffs.push('🛡️ درع نشط');
      if (hasDouble) buffs.push('🚀 مضاعفة ×2');
      if (stealTargetId) {
        buffs.push(stealTargetId === 'ACTIVE'
          ? '🧲 سرقة نقاط'
          : `🧲 سرقة من: ${getTeamName(stealTargetId, state.settings)}`);
      }
      buffEl.textContent = buffs.join(' • ');

      const btn = document.getElementById('mob-buzzer-btn');
      const label = document.getElementById('mob-buzzer-label');
      btn.className = 'buzzer-btn';

      if (isElim) {
        btn.disabled = true;
        btn.classList.add('state-blocked');
        label.textContent = 'تم إقصاء فريقك في هذه الجولة';
        return;
      }
      if (isFrozen) {
        btn.disabled = true;
        btn.classList.add('state-blocked');
        const endTs = Math.max(freezeMapEnd, Number(eff.freezeUntil) || 0);
        const freezeRem = Math.max(1, Math.ceil((endTs - syncedNow) / 1000));
        label.textContent = `❄️ ضاغطك مجمد (${freezeRem}ث)!`;
        return;
      }
      if (isAttempted && ['QUESTION_ACTIVE', 'BUZZER_LOCKED', 'ANSWER_TIMEOUT'].includes(state.fsmState)) {
        btn.disabled = true;
        btn.classList.add('state-blocked');
        label.textContent = 'استنفدت محاولتك في هذا السؤال';
        return;
      }

      if (state.fsmState === 'CATEGORY_BOARD') {
        btn.disabled = true;
        if (String(state.activeTurnTeamId) === tId) {
          btn.classList.add('state-winner');
          label.textContent = '🎯 دوركم الآن! اختر الفئة والصعوبة شفهياً';
        } else {
          label.textContent = `دور الاختيار لـ: ${getTeamName(state.activeTurnTeamId, state.settings)}`;
        }
        return;
      }

      if (state.fsmState === 'QUESTION_ACTIVE' && !state.lockedTeamId && !state.isTimerPaused) {
        btn.disabled = false;
        btn.classList.add('state-ready');
        label.textContent = 'اضغط الآن!';
      } else if (state.fsmState === 'QUESTION_ACTIVE' && state.isTimerPaused) {
        btn.disabled = true;
        label.textContent = '⏸️ المؤقت متوقف مؤقتاً';
      } else if (state.lockedTeamId === tId) {
        btn.disabled = true;
        btn.classList.add('state-winner');
        label.textContent = 'أنت الأسرع! أجب الآن';
      } else if (state.lockedTeamId && state.lockedTeamId !== tId) {
        btn.disabled = true;
        btn.classList.add('state-blocked');
        label.textContent = `سبقك: ${getTeamName(state.lockedTeamId, state.settings)}`;
      } else if (state.fsmState === 'ANSWER_TIMEOUT') {
        btn.disabled = true;
        label.textContent = '⏰ انتهى وقت الإجابة — بانتظار المذيع';
      } else {
        btn.disabled = true;
        label.textContent = 'انتظر السؤال';
      }
    }

    function openTargetedStealModal() {
      if (!appState) return;
      const victims = getEligibleStealVictims(appState, TEAM_ID);
      if (victims.length === 0) {
        showToast('⚠️ لا يوجد منافس نشط يملك نقاطاً للسرقة حالياً');
        return;
      }
      const qPts = Number(appState.currentQuestionPoints) || 100;
      const listEl = document.getElementById('steal-victims-list');
      listEl.innerHTML = victims.map(v => {
        const gain = Math.min(v.score, Math.floor(qPts / 2));
        return `
          <button class="steal-victim-btn" onclick="confirmTargetedSteal('${v.id}')">
            <span>🎯 ${escapeHTML(v.name)} <small style="color:var(--text-secondary);">(${v.score} نقطة)</small></span>
            <span class="pu-count-pill">سرقة +${gain}</span>
          </button>
        `;
      }).join('');
      document.getElementById('steal-target-modal').classList.remove('hidden');
    }

    function closeTargetedStealModal() {
      document.getElementById('steal-target-modal').classList.add('hidden');
    }

    function confirmTargetedSteal(targetTeamId) {
      closeTargetedStealModal();
      handlePowerUp('steal', targetTeamId);
    }

    function renderHostView(state) {
      const mode = (state.settings && state.settings.playMode) || 'BOARD';
      const modeLabels = {
        'BOARD': 'النمط النشط: لوحة الفئات والصعوبات (سؤال لكل فريق + عودة تلقائية للوحة)',
        'AUTO_CATEGORY': 'النمط النشط: تلقائي مستمر داخل الفئة والصعوبة المختارة من الفريق',
        'AUTO_ALL': 'النمط النشط: تلقائي شامل متتابع لجميع الأسئلة',
        'MANUAL': 'النمط النشط: الاختيار اليدوي المباشر من القائمة'
      };
      document.getElementById('host-mode-subtitle').textContent = modeLabels[mode] || modeLabels['BOARD'];
      document.getElementById('host-turn-team').textContent = getTeamName(state.activeTurnTeamId || '1', state.settings);

      const activeSlotEl = document.getElementById('host-active-slot-badge');
      if (state.selectedCategory && state.selectedDifficulty) {
        activeSlotEl.textContent = `📌 الخانة المقفلة للتلقائي: [${state.selectedCategory} - ${state.selectedDifficulty}]`;
        activeSlotEl.style.color = 'var(--icon-primary)';
      } else {
        activeSlotEl.textContent = '📌 الخانة المحددة للتلقائي: بانتظار اختيار خانة من اللوحة';
        activeSlotEl.style.color = 'var(--text-secondary)';
      }

      // أزرار الإيقاف/الاستئناف المسرحي واستبدال السؤال النشط
      const pauseBtn = document.getElementById('btn-pause-timer');
      const replaceBtn = document.getElementById('btn-replace-question');
      const canPause = ['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState);
      const canReplace = ['QUESTION_ACTIVE', 'BUZZER_LOCKED', 'ANSWER_TIMEOUT'].includes(state.fsmState) && Boolean(state.currentQuestion);
      if (pauseBtn) {
        pauseBtn.disabled = !canPause;
        pauseBtn.textContent = state.isTimerPaused ? '▶️ استئناف المؤقت' : '⏸️ إيقاف المؤقت';
      }
      if (replaceBtn) {
        replaceBtn.disabled = !canReplace;
      }

      // تنبيه انتهاء وقت الإجابة الفورية (< 10 ثوانٍ)
      const timeoutBox = document.getElementById('host-timeout-box');
      if (state.fsmState === 'ANSWER_TIMEOUT') {
        timeoutBox.classList.remove('hidden');
        document.getElementById('host-timeout-msg').textContent =
          `⏰ انتهى وقت إجابة فريق (${getTeamName(state.timedOutTeamId, state.settings)}) وتم حجب محاولته لهذا السؤال! اختر الإجراء الفوري:`;
      } else {
        timeoutBox.classList.add('hidden');
      }

      const previewBox = document.getElementById('host-live-question-preview');
      if (state.currentQuestion && ['QUESTION_ACTIVE', 'BUZZER_LOCKED', 'ANSWER_TIMEOUT', 'ANSWER_CORRECT', 'ANSWER_WRONG'].includes(state.fsmState)) {
        const cq = state.currentQuestion;
        previewBox.classList.remove('hidden');
        document.getElementById('host-preview-meta').textContent = `السؤال المعروض حالياً: [${cq.round} • ${cq.category} • ${cq.difficulty}]`;
        document.getElementById('host-preview-text').textContent = cq.question;
        document.getElementById('host-preview-answer').textContent = cq.correct
          ? `🔑 الإجابة الصحيحة: (${cq.correct}) ${cq.options[cq.correct] || ''}`
          : '🔒 الإجابة الصحيحة محجوبة تلقائياً عن الشاشات حتى لحظة التقييم (Zero-Leak)';
      } else {
        previewBox.classList.add('hidden');
      }

      const hostPuAlert = document.getElementById('host-powerup-alert');
      if (state.activeEffects && state.activeEffects.lastPowerUpBanner && ['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState)) {
        hostPuAlert.textContent = state.activeEffects.lastPowerUpBanner;
        hostPuAlert.classList.remove('hidden');
      } else {
        hostPuAlert.classList.add('hidden');
      }

      // التراجع بضغطة واحدة (One-Click Undo)
      const undoBtn = document.getElementById('btn-undo-evaluation');
      const undoHint = document.getElementById('host-undo-hint');
      if (undoBtn && undoHint) {
        undoBtn.disabled = !state.canUndoEvaluation;
        undoHint.textContent = state.canUndoEvaluation
          ? `متاح للتراجع الفوري: ${state.undoSummary}`
          : 'لا يوجد حكم تحكيمي حديث للتراجع عنه';
      }

      // لوحة تعديل النقاط الفوري لكل فريق
      const count = Number(state.settings && state.settings.teamCount) || 4;
      const refSig = JSON.stringify({
        count,
        scores: state.scores,
        names: Array.from({ length: count }, (_, i) => getTeamName(String(i + 1), state.settings))
      });
      if (refSig !== lastRefereeScoresSig) {
        lastRefereeScoresSig = refSig;
        const refGrid = document.getElementById('host-referee-scores-grid');
        if (refGrid) {
          let html = '';
          for (let i = 1; i <= count; i++) {
            const id = String(i);
            const tName = getTeamName(id, state.settings);
            const sc = Number((state.scores && state.scores[id]) || 0);
            html += `
              <div class="referee-team-card">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <strong style="font-size:13.5px;">${i}. ${escapeHTML(tName)}</strong>
                  <span style="font-weight:900; color:var(--icon-primary);">${sc} نقطة</span>
                </div>
                <div style="display:flex; gap:5px; flex-wrap:wrap; align-items:center;">
                  <button class="btn btn-sm btn-success" onclick="hostAdjustTeamScore('${id}', 50)">+50</button>
                  <button class="btn btn-sm btn-success" onclick="hostAdjustTeamScore('${id}', 100)">+100</button>
                  <button class="btn btn-sm btn-danger" onclick="hostAdjustTeamScore('${id}', -50)">-50</button>
                  <input type="number" id="ref-custom-pts-${id}" class="form-control" placeholder="±قيمة" style="width:78px; padding:5px 8px; font-size:12.5px;">
                  <button class="btn btn-sm btn-primary" onclick="hostApplyCustomScore('${id}')">تطبيق</button>
                </div>
              </div>
            `;
          }
          refGrid.innerHTML = html;
        }

        const grantTeamSelect = document.getElementById('grant-pu-team');
        if (grantTeamSelect) {
          const prevVal = grantTeamSelect.value || '1';
          grantTeamSelect.innerHTML = Array.from({ length: count }, (_, i) => {
            const id = String(i + 1);
            return `<option value="${id}">${id}. ${escapeHTML(getTeamName(id, state.settings))}</option>`;
          }).join('');
          if (Number(prevVal) <= count) grantTeamSelect.value = prevVal;
        }
      }

      const rSelect = document.getElementById('host-round-filter');
      if (rSelect && state.selectedRound && document.activeElement !== rSelect && rSelect.value !== state.selectedRound) {
        const hasOption = Array.from(rSelect.options).some(o => o.value === state.selectedRound);
        if (hasOption) {
          rSelect.value = state.selectedRound;
          filterQuestionsDropdown();
        }
      }

      const matrix = buildCategoryMatrix(state.usedQuestionIds, state.selectedRound);
      const hostBoardSig = JSON.stringify({
        loaded: questionsLoaded,
        matrix,
        selCat: state.selectedCategory,
        selDiff: state.selectedDifficulty,
        pts: [state.settings.pointsEasy, state.settings.pointsMedium, state.settings.pointsHard]
      });

      if (hostBoardSig !== lastHostBoardSig) {
        lastHostBoardSig = hostBoardSig;
        const catNames = Object.keys(matrix);
        document.getElementById('host-categories-grid').innerHTML = catNames.length
          ? catNames.map(cat => `
              <div class="host-cat-box">
                <div style="font-weight:900; color:var(--icon-primary); border-bottom:1px solid var(--border-subtle); padding-bottom:6px;">
                  ${escapeHTML(cat)}
                </div>
                ${DIFFICULTY_LEVELS.map(diff => {
                  const rem = matrix[cat][diff] || 0;
                  const pts = getDifficultyPoints(diff, state.settings);
                  const isSelected = (state.selectedCategory === cat && state.selectedDifficulty === diff);
                  return `
                    <button class="btn host-diff-btn ${isSelected ? 'is-active-slot' : ''}"
                            data-cat="${escapeAttr(cat)}"
                            data-diff="${diff}"
                            ${rem === 0 ? 'disabled' : ''}
                            onclick="hostPickBoardSlot(this)">
                      <span>${diff} (${pts})</span>
                      <span style="font-size:12px; color:var(--text-secondary);">متبقي: ${rem}</span>
                    </button>
                  `;
                }).join('')}
              </div>
            `).join('')
          : '<p style="color:var(--text-secondary); font-weight:800;">لا توجد أسئلة مطابقة للجولة المختارة؛ اضغط "تحديث الأسئلة" أو اختر "جميع الجولات".</p>';
      }

      const lockText = document.getElementById('host-lock-text');
      if (state.fsmState === 'ANSWER_TIMEOUT') {
        lockText.textContent = `⏰ انتهى وقت إجابة (${getTeamName(state.timedOutTeamId, state.settings)}) — بانتظار قرار المذيع`;
      } else if (state.lockedTeamId) {
        lockText.textContent = `⚡ الفريق الضاغط أولاً: ${getTeamName(state.lockedTeamId, state.settings)} (${state.fsmState})`;
      } else if (state.autoTransitionAction === 'RETURN_TO_BOARD') {
        lockText.textContent = '⏳ جاري العودة التلقائية للوحة الفئات وتمرير الدور...';
      } else if (state.autoTransitionAction === 'NEXT_IN_SLOT') {
        lockText.textContent = `⏳ جاري سحب السؤال التالي تلقائياً من (${state.selectedCategory} - ${state.selectedDifficulty})...`;
      } else if (state.autoTransitionAction === 'NEXT_IN_ALL') {
        lockText.textContent = '⏳ جاري سحب السؤال التالي تلقائياً...';
      } else {
        lockText.textContent = `حالة الجولة الحالية: ${state.fsmState}`;
      }

      const elim = state.eliminatedTeams || [];
      document.getElementById('host-elim-summary').textContent = elim.length
        ? `الفرق المستبعدة حالياً: ${elim.map(id => getTeamName(id, state.settings)).join(' ، ')}`
        : 'الفرق المستبعدة حالياً: لا يوجد (جميع الفرق نشطة)';

      if (count !== lastRenderedTeamCount) {
        lastRenderedTeamCount = count;
        renderQRLinks(state);
      }
    }

    // 6. زر تحديث الأسئلة الفوري والمزامن مع التلفاز (مع إعادة المحاولة التلقائية)
    function hostRefreshQuestions(btnEl) {
      const originalText = btnEl.textContent;
      btnEl.disabled = true;
      btnEl.textContent = '⏳ جاري التحديث...';

      callServerWithRetry(
        'refreshQuestionsBank',
        [],
        (res) => {
          btnEl.disabled = false;
          btnEl.textContent = originalText;
          if (res && res.status === 'OK' && res.state) {
            applyIncomingState(res.state, res.questions);
            showToast(res.message || '✅ تم تحديث الأسئلة بنجاح');
          } else {
            showToast('⚠️ الخادم مشغول، أعد المحاولة بعد ثانية');
          }
        },
        () => {
          btnEl.disabled = false;
          btnEl.textContent = originalText;
          showToast('❌ تعذر الاتصال بالجدول');
        }
      );
    }

    // 7. أزرار التصفير الأربعة المستقلة (مع إعادة المحاولة التلقائية وتحديث الأسئلة)
    function hostExecuteReset(resetType, btnEl) {
      const originalText = btnEl.textContent;
      btnEl.disabled = true;
      btnEl.textContent = '⏳ جاري التنفيذ...';

      const methodMap = {
        scores: 'resetScoresOnly',
        powerups: 'resetPowerUpsOnly',
        questions: 'resetUsedQuestionsOnly',
        full: 'resetMatchFull'
      };

      callServerWithRetry(
        methodMap[resetType],
        [],
        (res) => {
          btnEl.disabled = false;
          btnEl.textContent = originalText;
          if (res && res.status === 'OK' && res.state) {
            lastHostBoardSig = '';
            lastTvBoardSig = '';
            applyIncomingState(res.state, res.questions || null);
            showToast(res.message || '✅ تم التحديث بنجاح');
          } else {
            showToast('⚠️ الخادم مشغول بمعالجة ضغطات أخرى، حاول مجدداً');
          }
        },
        () => {
          btnEl.disabled = false;
          btnEl.textContent = originalText;
          showToast('⚠️ حدث تأخير في الاتصال، أعد المحاولة');
        }
      );
    }

    // 8. تفاعلات المتسابق والمذيع
    function handleBuzzerPress() {
      if (localBuzzerLock) return;
      localBuzzerLock = true;
      document.getElementById('mob-buzzer-btn').disabled = true;
      document.getElementById('mob-buzzer-label').textContent = 'جاري التحقق...';

      google.script.run
        .withSuccessHandler((res) => {
          localBuzzerLock = false;
          if (res && res.state) applyIncomingState(res.state);
        })
        .withFailureHandler(() => { localBuzzerLock = false; })
        .triggerBuzzer(TEAM_ID);
    }

    function handlePowerUp(type, targetTeamId) {
      const btn = document.getElementById(`pu-${type}`);
      if (btn) btn.disabled = true;
      callServerWithRetry(
        'activatePowerUp',
        [TEAM_ID, type, targetTeamId || null],
        (res) => {
          if (res && res.status === 'OK' && res.state) {
            applyIncomingState(res.state);
            showToast('✅ تم تفعيل الأداة التكتيكية بنجاح');
          } else if (res && res.message) {
            showToast(`⚠️ ${res.message}`);
            if (appState) renderMobileView(appState);
          }
        },
        () => { if (appState) renderMobileView(appState); }
      );
    }

    function loadQuestionsFromSheet() {
      google.script.run
        .withSuccessHandler((list) => {
          syncQuestionsList(list);
          if (appState) renderCurrentView(appState);
        })
        .withFailureHandler(() => {
          showToast('⚠️ تعذر قراءة بنك الأسئلة');
        })
        .getQuestionsBank();
    }

    function onHostRoundChange() {
      const val = document.getElementById('host-round-filter').value;
      lastHostBoardSig = '';
      filterQuestionsDropdown();
      callServerWithRetry('setSelectedRound', [val], (res) => {
        if (res && res.state) applyIncomingState(res.state);
      });
    }

    function filterQuestionsDropdown() {
      const selectedRound = document.getElementById('host-round-filter').value;
      const filtered = selectedRound === 'ALL'
        ? questionsBank
        : questionsBank.filter(q => (q.round || 'الجولة 1') === selectedRound);

      document.getElementById('host-q-select').innerHTML = filtered.map(q =>
        `<option value="${q.id}">${q.id}. [${escapeHTML(q.category)} - ${escapeHTML(q.difficulty)}] ${escapeHTML(q.question)}</option>`
      ).join('');
    }

    function hostPickBoardSlot(btnEl) {
      if (boardSlotActionLock) return;
      boardSlotActionLock = true;
      const category = btnEl.dataset.cat;
      const difficulty = btnEl.dataset.diff;
      btnEl.disabled = true;
      showToast(`⏳ جاري فتح سؤال (${category} - ${difficulty})...`);

      callServerWithRetry(
        'pickBoardQuestion',
        [category, difficulty],
        (res) => {
          boardSlotActionLock = false;
          if (res && res.state) {
            lastHostBoardSig = '';
            applyIncomingState(res.state);
          }
          if (res && res.status === 'EMPTY_SLOT') {
            showToast(`⚠️ ${res.message}`);
          }
        },
        () => {
          boardSlotActionLock = false;
          btnEl.disabled = false;
        }
      );
    }

