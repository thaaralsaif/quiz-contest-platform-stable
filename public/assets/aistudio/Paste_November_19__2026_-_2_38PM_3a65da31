function sanitizeSettingsPayload(rawInput) {
  const defaults = getDefaultSettingsObject();
  const src = rawInput || {};

  const validPlayModes = ['BOARD', 'AUTO_CATEGORY', 'AUTO_ALL', 'MANUAL'];
  const validAnswerModes = ['FIXED', 'BY_DIFFICULTY'];
  const validSpeedModes = ['FIXED', 'SPEED_TIERED', 'SPEED_LINEAR'];
  const validTieBreakers = ['SCORE_THEN_CORRECT_THEN_SPEED', 'GOLDEN_QUESTION'];
  const validUnlockConds = ['ALWAYS', 'STREAK_2', 'STREAK_3', 'TRAILING_ONLY', 'MIN_POINTS_300'];

  const sanitized = {
    playMode: validPlayModes.includes(src.playMode) ? src.playMode : defaults.playMode,
    teamCount: clampNumber(src.teamCount, 2, MAX_TEAMS, defaults.teamCount),
    timerSeconds: clampNumber(src.timerSeconds, 5, 300, defaults.timerSeconds),
    answerTimerMode: validAnswerModes.includes(src.answerTimerMode) ? src.answerTimerMode : defaults.answerTimerMode,
    answerSeconds: clampNumber(src.answerSeconds, 5, 60, defaults.answerSeconds),
    answerSecEasy: clampNumber(src.answerSecEasy, 5, 60, defaults.answerSecEasy),
    answerSecMedium: clampNumber(src.answerSecMedium, 5, 60, defaults.answerSecMedium),
    answerSecHard: clampNumber(src.answerSecHard, 5, 60, defaults.answerSecHard),
    speedScoringMode: validSpeedModes.includes(src.speedScoringMode) ? src.speedScoringMode : defaults.speedScoringMode,
    pointsEasy: clampNumber(src.pointsEasy, 10, 10000, defaults.pointsEasy),
    pointsMedium: clampNumber(src.pointsMedium, 10, 10000, defaults.pointsMedium),
    pointsHard: clampNumber(src.pointsHard, 10, 10000, defaults.pointsHard),
    pointsWrongPenalty: clampNumber(src.pointsWrongPenalty, 0, 10000, defaults.pointsWrongPenalty),
    matchDurationMinutes: clampNumber(src.matchDurationMinutes, 0, 600, defaults.matchDurationMinutes),
    targetCorrectAnswers: clampNumber(src.targetCorrectAnswers, 0, 500, defaults.targetCorrectAnswers),
    maxQuestionsPerMatch: clampNumber(src.maxQuestionsPerMatch, 0, 1000, defaults.maxQuestionsPerMatch),
    tieBreakerRule: validTieBreakers.includes(src.tieBreakerRule) ? src.tieBreakerRule : defaults.tieBreakerRule,
    powerUpsEnabled: parseBoolSetting(src.powerUpsEnabled, defaults.powerUpsEnabled),
    powerUpUnlockCondition: validUnlockConds.includes(src.powerUpUnlockCondition) ? src.powerUpUnlockCondition : defaults.powerUpUnlockCondition,
    puShieldCount: clampNumber(src.puShieldCount, 0, 10, defaults.puShieldCount),
    puAiCount: clampNumber(src.puAiCount, 0, 10, defaults.puAiCount),
    puDoubleCount: clampNumber(src.puDoubleCount, 0, 10, defaults.puDoubleCount),
    puFreezeCount: clampNumber(src.puFreezeCount, 0, 10, defaults.puFreezeCount),
    puStealCount: clampNumber(src.puStealCount, 0, 10, defaults.puStealCount),
    puTimeCount: clampNumber(src.puTimeCount, 0, 10, defaults.puTimeCount),
    permScoreEdit: parseBoolSetting(src.permScoreEdit, defaults.permScoreEdit),
    permUndo: parseBoolSetting(src.permUndo, defaults.permUndo),
    permTimerControl: parseBoolSetting(src.permTimerControl, defaults.permTimerControl),
    permQuestionReplace: parseBoolSetting(src.permQuestionReplace, defaults.permQuestionReplace),
    permGrantPowerUp: parseBoolSetting(src.permGrantPowerUp, defaults.permGrantPowerUp),
    permElimination: parseBoolSetting(src.permElimination, defaults.permElimination),
    fontPair: cleanArabicLabel(src.fontPair, defaults.fontPair)
  };

  for (let i = 1; i <= MAX_TEAMS; i++) {
    const k = `team${i}Name`;
    sanitized[k] = sanitizeForSheet(cleanArabicLabel(src[k], defaults[k]));
  }

  return sanitized;
}

function readSettingsFromSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sSheet = ss.getSheetByName('Settings');
  const rawMap = getDefaultSettingsObject();
  if (!sSheet || sSheet.getLastRow() < 2) return sanitizeSettingsPayload(rawMap);

  const data = sSheet.getRange(2, 1, sSheet.getLastRow() - 1, 2).getValues();
  data.forEach(([key, val]) => {
    const k = String(key || '').trim();
    if (k in rawMap) {
      rawMap[k] = val;
    }
  });
  return sanitizeSettingsPayload(rawMap);
}

// 5. الدالة المركزية الموحدة لاحتساب مهلة الإجابة (5 - 60 ثانية موحدة أو حسب الصعوبة)
function resolveAnswerDurationSeconds(state, questionObj) {
  const s = (state && state.settings) || getDefaultSettingsObject();
  const q = questionObj || (state && state.currentQuestion) || null;
  if (s.answerTimerMode === 'BY_DIFFICULTY' && q) {
    const diff = normalizeDifficulty(q.difficulty);
    if (diff === 'صعب') return clampNumber(s.answerSecHard, 5, 60, 30);
    if (diff === 'متوسط') return clampNumber(s.answerSecMedium, 5, 60, 20);
    return clampNumber(s.answerSecEasy, 5, 60, 10);
  }
  return clampNumber(s.answerSeconds, 5, 60, 10);
}

// 6. محرك احتساب النقاط والسرعة الديناميكي
function calculateAwardedPoints(basePts, elapsedMs, settings) {
  const s = settings || getDefaultSettingsObject();
  const mode = s.speedScoringMode || 'FIXED';
  const base = Math.max(10, Number(basePts) || 100);

  if (mode === 'FIXED') {
    return { totalPoints: base, speedBonus: 0 };
  }

  const totalQuestionMs = Math.max(5000, (Number(s.timerSeconds) || 25) * 1000);
  const clampedElapsed = Math.max(0, Math.min(totalQuestionMs, Number(elapsedMs) || totalQuestionMs));
  const ratio = clampedElapsed / totalQuestionMs;

  if (mode === 'SPEED_TIERED') {
    let multiplier = 1.0;
    if (ratio <= 0.30) {
      multiplier = 1.5;
    } else if (ratio <= 0.60) {
      multiplier = 1.25;
    }
    const total = Math.round(base * multiplier);
    return { totalPoints: total, speedBonus: Math.max(0, total - base) };
  }

  if (mode === 'SPEED_LINEAR') {
    const bonusFactor = 0.5 * (1 - ratio);
    const total = Math.round(base * (1 + bonusFactor));
    return { totalPoints: total, speedBonus: Math.max(0, total - base) };
  }

  return { totalPoints: base, speedBonus: 0 };
}

// 7. محرك بوابات تفعيل الأدوات التكتيكية
function evaluatePowerUpGateForTeam(state, teamId) {
  const s = state.settings || getDefaultSettingsObject();
  const puEnabled = parseBoolSetting(s.powerUpsEnabled, true);
  if (!puEnabled) {
    return { unlocked: false, reason: 'الأدوات التكتيكية معطلة في إعدادات هذه المباراة' };
  }

  const cond = s.powerUpUnlockCondition || 'ALWAYS';
  if (cond === 'ALWAYS') {
    return { unlocked: true, reason: '' };
  }

  ensureTelemetryStructure(state);
  const tId = String(teamId);
  const tStats = state.telemetry.perTeam[tId] || {};
  const streak = Number(tStats.currentStreak) || 0;
  const score = Number((state.scores && state.scores[tId]) || 0);

  if (cond === 'STREAK_2') {
    if (streak >= 2) return { unlocked: true, reason: '' };
    return { unlocked: false, reason: `تُفتح الأدوات بعد إجابتين صحيحتين متتاليتين (الحالي: ${streak}/2)` };
  }

  if (cond === 'STREAK_3') {
    if (streak >= 3) return { unlocked: true, reason: '' };
    return { unlocked: false, reason: `تُفتح الأدوات بعد 3 إجابات صحيحة متتالية (الحالي: ${streak}/3)` };
  }

  if (cond === 'MIN_POINTS_300') {
    if (score >= 300) return { unlocked: true, reason: '' };
    return { unlocked: false, reason: `تُفتح الأدوات عند بلوغ 300 نقطة (رصيدكم: ${score})` };
  }

  if (cond === 'TRAILING_ONLY') {
    const count = Number(s.teamCount) || 4;
    const eliminated = state.eliminatedTeams || [];
    let maxScore = 0;
    for (let i = 1; i <= count; i++) {
      const id = String(i);
      if (!eliminated.includes(id)) {
        const sc = Number((state.scores && state.scores[id]) || 0);
        if (sc > maxScore) maxScore = sc;
      }
    }
    const minGap = Number(s.pointsMedium) || 200;
    if (maxScore - score >= minGap) {
      return { unlocked: true, reason: '' };
    }
    return { unlocked: false, reason: `متاحة فقط للفرق المتأخرة بفارق ${minGap}+ نقطة عن المتصدر` };
  }

  return { unlocked: true, reason: '' };
}

function buildPowerUpsQuota(settings) {
  const powerUps = {};
  for (let i = 1; i <= MAX_TEAMS; i++) {
    const id = String(i);
    powerUps[id] = {
      shield: clampNumber(settings.puShieldCount, 0, 10, 1),
      ai: clampNumber(settings.puAiCount, 0, 10, 1),
      double: clampNumber(settings.puDoubleCount, 0, 10, 1),
      freeze: clampNumber(settings.puFreezeCount, 0, 10, 1),
      steal: clampNumber(settings.puStealCount, 0, 10, 1),
      time: clampNumber(settings.puTimeCount, 0, 10, 1)
    };
  }
  return powerUps;
}

