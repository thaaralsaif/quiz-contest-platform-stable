        finalizeMatchToPodium(state, 'BANK_EXHAUSTED', '🏁 اكتملت جميع الأسئلة المتاحة — إعلان الأبطال!');
      }
      state.currentQuestion = null;
      state.questionEndTime = null;
      state.answerEndTime = null;
      state.votedTeams = [];
      state.revealedChoices = null;
      state.autoTransitionAction = null;
      state.autoTransitionAt = null;
      rebuildStateBoardSnapshot(state, allQ);
      persistLiveState(state);
      return { status: 'FINISHED', state: sanitizeStateForClient(state) };
    }
  }

  return launchQuestionInternal(state, nextQ, allQ);
