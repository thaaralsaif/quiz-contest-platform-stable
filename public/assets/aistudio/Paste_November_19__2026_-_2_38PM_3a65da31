function launchQuestionInternal(state, questionObj, allQ) {
  const duration = Number(state.settings.timerSeconds) || 25;
  const used = (state.usedQuestionIds || []).map(Number);
  const qId = Number(questionObj.id);
  if (!used.includes(qId)) used.push(qId);

  const normDiff = normalizeDifficulty(questionObj.difficulty);
  const cleanQuestion = Object.assign({}, questionObj, { difficulty: normDiff });
  const answerSec = resolveAnswerDurationSeconds(state, cleanQuestion);
  const now = Date.now();

  if (Number(state.settings.matchDurationMinutes) > 0 && !state.matchStartedAt) {
    state.matchStartedAt = now;
    state.matchTotalPausedMs = 0;
  }

  clearSecretChoicesMap();

  state.usedQuestionIds = used;
  state.fsmState = 'QUESTION_ACTIVE';
  state.activeResponseMode = (state.nextResponseMode === 'SILENT_CHOICE') ? 'SILENT_CHOICE' : 'BUZZER';
  state.votedTeams = [];
  state.revealedChoices = null;
  state.currentQuestion = cleanQuestion;
  state.currentRoundLabel = cleanQuestion.round || 'الجولة 1';
  state.currentQuestionPoints = getPointsForDifficulty(normDiff, state.settings);
  state.currentAnswerDurationSec = answerSec;
  state.lockedTeamId = null;
  state.timedOutTeamId = null;
  state.attemptedTeamsThisQuestion = [];
  state.lastEliminatedTeam = null;
  state.lastStealSummary = null;
  state.lastSpeedBonusAwarded = 0;
  state.autoTransitionAction = null;
  state.autoTransitionAt = null;
  state.isTimerPaused = false;
  state.pausedRemaining = duration;
  state.pausedAnswerRemaining = answerSec;
  state.questionEndTime = now + (duration * 1000);
  state.answerEndTime = null;
  state.activeQuestionStartedAt = now;
  state.accumulatedActiveMs = 0;
  state.activeEffects = getEmptyEffects();

  rebuildStateBoardSnapshot(state, allQ);
  persistLiveState(state);
  return { status: 'OK', state: sanitizeStateForClient(state) };
}

function executeScheduledTransition() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const now = Date.now();

    // التحقق أولاً من شروط انتهاء المباراة المدمجة قبل الانتقال للسؤال التالي
    const termCheck = checkAndApplyMatchTermination(state, now, false);
    if (termCheck.terminated) {
      persistLiveState(state);
      return { status: 'FINISHED', state: sanitizeStateForClient(state) };
    }

    if (!state.autoTransitionAction || !state.autoTransitionAt) {
      return { status: 'NO_ACTION', state: sanitizeStateForClient(state) };
    }
    if (now < state.autoTransitionAt - 200) {
      return { status: 'TOO_EARLY', state: sanitizeStateForClient(state) };
    }

    const action = state.autoTransitionAction;
    state.autoTransitionAction = null;
    state.autoTransitionAt = null;

    if (action === 'RETURN_TO_BOARD') {
      clearSecretChoicesMap();
      state.fsmState = 'CATEGORY_BOARD';
      state.currentQuestion = null;
      state.questionEndTime = null;
      state.answerEndTime = null;
      state.isTimerPaused = false;
      state.lockedTeamId = null;
      state.timedOutTeamId = null;
      state.attemptedTeamsThisQuestion = [];
      state.votedTeams = [];
      state.revealedChoices = null;
      state.selectedCategory = null;
      state.selectedDifficulty = null;
      state.lastStealSummary = null;
      state.activeEffects = getEmptyEffects();
      persistLiveState(state);
      return { status: 'OK', state: sanitizeStateForClient(state) };
    }

    return launchNextAutoQuestionInternal(state);
  } finally {
    lock.releaseLock();
  }
}

