/**
 * ============================================================================
 * المحرك المعماري لمنصة المسابقات متعددة الشاشات - الإصدار V12.0+ (Hybrid Engine)
 * ============================================================================
 * يشمل جميع ميزات V11.0+ مع ترقيات V12.0+ الهجينة:
 * 1. محرك إعدادات المباراة القابلة للدمج (السرعة، مؤقت المباراة الكلي حتى ساعات،
 *    هدف الإجابات الصحيحة، الحد الأقصى للأسئلة، وكسر التعادل بالسؤال الذهبي).
 * 2. مهلة الإجابة المرنة بعد الضغط (5 إلى 60 ثانية موحدة، أو حسب الصعوبة: 10/20/30ث).
 * 3. بوابات تفعيل الأدوات التكتيكية (دائماً، سلسلة انتصارات Streak، للمتأخرين، أو رصيد 300+).
 * 4. مصفوفة صلاحيات المقدم المفروضة أمنياً في الخادم (Server-Side Guards).
 * 5. دعم الإجابة السرية الجماعية (SILENT_CHOICE) والوسائط (MediaUrl + Drive) وإحصائيات MVP.
 * 6. طبقة حفظ ثنائية (PropertiesService موثوقة + CacheService سريعة) مع LockService.
 */

const PROP_KEY_STATE = 'TRIVIA_LIVE_STATE_V8';
const PROP_KEY_MATRIX = 'TRIVIA_BOARD_MATRIX_V8';
const PROP_KEY_UNDO = 'TRIVIA_UNDO_SNAPSHOT_V10';
const PROP_KEY_SECRET_CHOICES = 'TRIVIA_SECRET_CHOICES_V11';
const CACHE_KEY_STATE = 'TRIVIA_CACHE_STATE_V12';
const CACHE_KEY_MATRIX = 'TRIVIA_CACHE_MATRIX_V12';
const CACHE_TTL_SECONDS = 21600;
const MAX_TEAMS = 8;

// 1. نقطة الدخول وتوجيه الشاشات الأربع (host, settings, tv, mobile)
function doGet(e) {
  const params = (e && e.parameter) ? e.parameter : {};
  const view = params.view || 'host';
  const teamId = params.team || '1';

  const template = HtmlService.createTemplateFromFile('index');
  template.view = view;
  template.teamId = teamId;
  template.scriptUrl = ScriptApp.getService().getUrl();

  return template.evaluate()
    .setTitle('بطولة النخبة الكبرى للمسابقات')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no');
}

// 2. دوال تنظيف النصوص العربية وتطبيع مستويات الصعوبة والوسائط
function sanitizeForSheet(value) {
  if (typeof value !== 'string') return value;
  return value.replace(/^[=+\-@]+/, "'$&");
}

function cleanArabicLabel(value, fallback) {
  const cleaned = String(value || '')
    .replace(/[\u200B-\u200D\uFEFF\u00A0]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return cleaned || (fallback || '');
}

function normalizeDifficulty(rawDiff) {
  const d = cleanArabicLabel(rawDiff, '').toLowerCase();
  if (d === 'صعب' || d === 'صعبة' || d === 'hard' || d === '3') return 'صعب';
  if (d === 'متوسط' || d === 'متوسطة' || d === 'medium' || d === '2') return 'متوسط';
  return 'سهل';
}

function clampNumber(val, min, max, fallback) {
  const n = Number(val);
  if (!Number.isFinite(n)) return fallback;
  return Math.min(max, Math.max(min, Math.round(n)));
}

function parseBoolSetting(val, fallback) {
  if (val === undefined || val === null || val === '') return fallback;
  if (typeof val === 'boolean') return val;
  const s = String(val).trim().toLowerCase();
  if (s === 'false' || s === '0' || s === 'no') return false;
  if (s === 'true' || s === '1' || s === 'yes') return true;
  return fallback;
}

function extractGoogleDriveFileId(url) {
  const str = String(url || '');
  let m = str.match(/\/file\/d\/([a-zA-Z0-9_-]{10,})/);
  if (m && m[1]) return m[1];
  m = str.match(/\/d\/([a-zA-Z0-9_-]{10,})/);
  if (m && m[1]) return m[1];
  m = str.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);
  if (m && m[1]) return m[1];
  return '';
}

function parseMediaMetadata(rawUrl) {
  let raw = cleanArabicLabel(rawUrl, '');
  if (!raw) {
    return { mediaUrl: '', mediaType: 'none', mediaDriveId: '' };
  }

  let explicitHint = '';
  if (/^audio\s*:/i.test(raw)) {
    explicitHint = 'audio';
    raw = raw.replace(/^audio\s*:/i, '').trim();
  } else if (/^image\s*:/i.test(raw)) {
    explicitHint = 'image';
    raw = raw.replace(/^image\s*:/i, '').trim();
  }

  if (!/^https?:\/\//i.test(raw)) {
    return { mediaUrl: '', mediaType: 'none', mediaDriveId: '' };
  }

  const isAudioExt = /\.(mp3|wav|ogg|m4a|aac|flac|opus)(\?|#|$)/i.test(raw);
  const isImageExt = /\.(jpg|jpeg|png|gif|webp|svg|bmp|avif)(\?|#|$)/i.test(raw);
  const isDrive = /drive\.google\.com|docs\.google\.com/i.test(raw);
  const driveId = isDrive ? extractGoogleDriveFileId(raw) : '';

  if (driveId) {
    const type = explicitHint || (isAudioExt ? 'audio' : 'image');
    const resolvedUrl = (type === 'audio')
      ? `https://docs.google.com/uc?export=open&id=${driveId}`
      : `https://drive.google.com/thumbnail?id=${driveId}&sz=w1200`;
    return { mediaUrl: resolvedUrl, mediaType: type, mediaDriveId: driveId };
  }

  const finalType = explicitHint || (isAudioExt ? 'audio' : (isImageExt ? 'image' : 'image'));
  return { mediaUrl: raw, mediaType: finalType, mediaDriveId: '' };
}

function getCurrentStoredRevisionSafe() {
  try {
    const raw = PropertiesService.getScriptProperties().getProperty(PROP_KEY_STATE);
    if (raw) {
      const parsed = JSON.parse(raw);
      return Number(parsed.stateRevision) || 1;
    }
  } catch (e) {
    Logger.log('getCurrentStoredRevisionSafe error: ' + e);
  }
  return 1;
}

// مسح جميع مفاتيح التخزين المؤقت والخصائص القديمة مع تجنب تضارب stateRevision
function purgeAllStorageNamespaces() {
  try {
    PropertiesService.getScriptProperties().deleteAllProperties();
  } catch (e) {
    Logger.log('purgeAllStorageNamespaces: properties wipe failed: ' + e);
  }

  try {
    const keys = [
      CACHE_KEY_STATE,
      CACHE_KEY_MATRIX,
      'TRIVIA_CACHE_STATE_V11',
      'TRIVIA_CACHE_MATRIX_V11',
      'TRIVIA_CACHE_STATE_V10',
      'TRIVIA_CACHE_MATRIX_V10',
      'TRIVIA_LIVE_STATE_V6',
      'TRIVIA_LIVE_STATE_V7',
      'TRIVIA_LIVE_STATE_V7_2',
      'TRIVIA_Q_META_V7',
      'TRIVIA_Q_META_V7_2'
    ];
    for (let v = 1; v <= 20; v++) {
      for (let c = 0; c < 15; c++) {
        keys.push(`TRIVIA_Q_CHUNK_V7_${c}`);
        keys.push(`TRIVIA_Q_CHUNK_V7_${v}_${c}`);
        keys.push(`TRIVIA_Q_CHUNK_V7_2_${v}_${c}`);
      }
    }
    CacheService.getScriptCache().removeAll(keys);
  } catch (e) {
    Logger.log('purgeAllStorageNamespaces: cache wipe failed: ' + e);
  }
}

// 3. تهيئة جداول البيانات (10 أعمدة تشمل MediaUrl الاختياري + ورقة Settings الكاملة)
function setupDatabase() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return { status: 'BUSY' };
  try {
    const monotonicRev = getCurrentStoredRevisionSafe();
    purgeAllStorageNamespaces();

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let qSheet = ss.getSheetByName('Questions');

    if (!qSheet) {
      qSheet = ss.insertSheet('Questions');
    } else {
      qSheet.clear();
    }

    qSheet.getRange(1, 1, 1, 10).setValues([[
      'ID', 'Round', 'Category', 'Difficulty', 'Question', 'OptionA', 'OptionB', 'OptionC', 'CorrectOption', 'MediaUrl'
    ]]).setFontWeight('bold').setBackground('#e2e8f0');
    qSheet.setFrozenRows(1);

    let sSheet = ss.getSheetByName('Settings');
    const defaultSettings = getDefaultSettingsObject();
    if (!sSheet) {
      sSheet = ss.insertSheet('Settings');
      sSheet.getRange(1, 1, 1, 2).setValues([['SettingKey', 'SettingValue']])
        .setFontWeight('bold').setBackground('#e2e8f0');
      sSheet.setFrozenRows(1);
      const rows = Object.entries(defaultSettings).map(([k, v]) => [k, String(v)]);
      sSheet.getRange(2, 1, rows.length, 2).setValues(rows);
    }

    const savedSettings = readSettingsFromSheet();
    const initialState = buildFreshState(savedSettings);
    initialState.stateRevision = monotonicRev;
    initialState.boardMatrix = {};
    initialState.totalQuestionsCount = 0;
    persistLiveState(initialState);

    return {
      status: 'SUCCESS',
      message: '✅ تم تهيئة قاعدة البيانات (10 أعمدة + إعدادات القواعد المدمجة) بنجاح',
      state: sanitizeStateForClient(initialState)
    };
  } finally {
    lock.releaseLock();
  }
}

function wipeQuestionsDatabase() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) return { status: 'BUSY' };
  try {
    const monotonicRev = getCurrentStoredRevisionSafe();
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let qSheet = ss.getSheetByName('Questions');
    if (!qSheet) {
      qSheet = ss.insertSheet('Questions');
    } else {
      const lastRow = qSheet.getLastRow();
      if (lastRow > 1) {
        qSheet.getRange(2, 1, lastRow - 1, Math.max(10, qSheet.getLastColumn())).clearContent();
        if (lastRow > 2) {
          qSheet.deleteRows(3, lastRow - 2);
        }
      }
    }

    qSheet.getRange(1, 1, 1, 10).setValues([[
      'ID', 'Round', 'Category', 'Difficulty', 'Question', 'OptionA', 'OptionB', 'OptionC', 'CorrectOption', 'MediaUrl'
    ]]).setFontWeight('bold').setBackground('#e2e8f0');
    qSheet.setFrozenRows(1);

    const currentSettings = readSettingsFromSheet();
    purgeAllStorageNamespaces();

    const fresh = buildFreshState(currentSettings);
    fresh.stateRevision = monotonicRev;
    fresh.boardMatrix = {};
    fresh.totalQuestionsCount = 0;
    fresh.questionsVersion = Date.now();
    persistLiveState(fresh);

    return {
      status: 'OK',
      message: '🗑️ تم حذف جميع الأسئلة والسجلات من قاعدة البيانات بنجاح',
      questions: [],
      state: sanitizeStateForClient(fresh)
    };
  } finally {
    lock.releaseLock();
  }
}

