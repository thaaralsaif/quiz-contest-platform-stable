    if (!perm.allowed) return { status: 'FORBIDDEN', message: perm.message };

    const allQ = readQuestionsFromSheetDirect();
    const used = (state.usedQuestionIds || []).map(Number);
    const activeRound = cleanArabicLabel(state.selectedRound, 'ALL');
    const curCat = state.currentQuestion ? cleanArabicLabel(state.currentQuestion.category, '') : null;
    const curDiff = state.currentQuestion ? normalizeDifficulty(state.currentQuestion.difficulty) : null;

    let replacement = allQ.find(q =>
      !used.includes(Number(q.id)) &&
      (activeRound === 'ALL' || cleanArabicLabel(q.round, 'الجولة 1') === activeRound) &&
      (!curCat || cleanArabicLabel(q.category, 'عام') === curCat) &&
      (!curDiff || normalizeDifficulty(q.difficulty) === curDiff)
    );

    if (!replacement) {
      replacement = allQ.find(q =>
        !used.includes(Number(q.id)) &&
        (activeRound === 'ALL' || cleanArabicLabel(q.round, 'الجولة 1') === activeRound)
      );
    }

    if (!replacement) {
      return { status: 'NO_REPLACEMENT', message: 'لا توجد أسئلة متاحة أخرى للاستبدال في هذه الجولة' };
    }

    state.refereeNotice = { text: '🔄 استبدل المذيع السؤال النشط بسؤال بديل جديد', at: Date.now() };
    return launchQuestionInternal(state, replacement, allQ);
