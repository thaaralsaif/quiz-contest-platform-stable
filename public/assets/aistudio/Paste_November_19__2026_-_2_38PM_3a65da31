// 25. جولات التصفيات والاحتفال
function eliminateLowestTeam() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const perm = assertHostPermission(state, 'permElimination', 'صلاحية الإقصاء معطلة في إعدادات البطولة');
    if (!perm.allowed) return { status: 'FORBIDDEN', message: perm.message };

    const count = Number(state.settings.teamCount) || 4;
    const eliminated = state.eliminatedTeams || [];

    const activeIds = [];
    for (let i = 1; i <= count; i++) {
      const id = String(i);
      if (!eliminated.includes(id)) activeIds.push(id);
    }

    if (activeIds.length <= 2) return { status: 'MIN_REACHED' };

    let lowestId = activeIds[0];
    let minScore = Number(state.scores[lowestId]) || 0;
    activeIds.forEach(id => {
      const sc = Number(state.scores[id]) || 0;
      if (sc < minScore) {
        minScore = sc;
        lowestId = id;
      }
    });

    clearSecretChoicesMap();
    eliminated.push(lowestId);
    state.eliminatedTeams = eliminated;
    state.lastEliminatedTeam = lowestId;
    if (eliminated.includes(state.activeTurnTeamId)) {
      state.activeTurnTeamId = computeNextTurnTeamId(state);
    }
    const isBoardBased = (state.settings.playMode === 'BOARD' || state.settings.playMode === 'AUTO_CATEGORY');
    state.fsmState = isBoardBased ? 'CATEGORY_BOARD' : 'WAITING_LOBBY';
    state.currentQuestion = null;
    state.questionEndTime = null;
    state.answerEndTime = null;
    state.isTimerPaused = false;
    state.lockedTeamId = null;
    state.timedOutTeamId = null;
    state.attemptedTeamsThisQuestion = [];
    state.votedTeams = [];
    state.revealedChoices = null;
    state.selectedCategory = null;
    state.selectedDifficulty = null;
    state.autoTransitionAction = null;
    state.autoTransitionAt = null;
    state.activeEffects = getEmptyEffects();

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

