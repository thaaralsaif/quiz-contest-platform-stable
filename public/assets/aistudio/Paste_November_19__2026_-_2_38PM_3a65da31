function passQuestionToNextTeam() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    if (!state.currentQuestion) return { status: 'NO_QUESTION', state: sanitizeStateForClient(state) };

    const count = Number(state.settings.teamCount) || 4;
    const eliminated = state.eliminatedTeams || [];
    const attempted = Array.isArray(state.attemptedTeamsThisQuestion) ? state.attemptedTeamsThisQuestion : [];
    if (state.lockedTeamId && !attempted.includes(state.lockedTeamId)) {
      attempted.push(state.lockedTeamId);
    }

    const startTeam = Number(state.lockedTeamId || state.timedOutTeamId || state.activeTurnTeamId || 1);
    let nextEligible = null;

    for (let step = 1; step <= count; step++) {
      const cand = String(((startTeam - 1 + step) % count) + 1);
      if (!eliminated.includes(cand) && !attempted.includes(cand)) {
        nextEligible = cand;
        break;
      }
    }

    if (!nextEligible) {
      return reopenBuzzerForRemainingTeamsInternalWithLock(state, attempted);
    }

    const answerSec = resolveAnswerDurationSeconds(state, state.currentQuestion);
    const nextName = state.settings[`team${nextEligible}Name`] || `فريق ${nextEligible}`;
    const now = Date.now();

    state.activeResponseMode = 'BUZZER';
    state.attemptedTeamsThisQuestion = attempted;
    state.fsmState = 'BUZZER_LOCKED';
    state.lockedTeamId = nextEligible;
    state.timedOutTeamId = null;
    state.questionEndTime = null;
    state.currentAnswerDurationSec = answerSec;
    state.pausedAnswerRemaining = answerSec;
    state.answerEndTime = now + (answerSec * 1000);
    state.isTimerPaused = false;
    state.autoTransitionAction = null;
    state.autoTransitionAt = null;
    state.refereeNotice = {
      text: `⏭️ حوّل المذيع فرصة الإجابة مباشرة إلى فريق (${nextName}) (${answerSec} ثانية)`,
      at: now
    };

    persistLiveState(state);
    return { status: 'OK', message: `⏭️ تم تحويل السؤال إلى (${nextName})`, state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

