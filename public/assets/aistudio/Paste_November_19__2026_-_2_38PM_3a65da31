      sheet = ss.insertSheet('Questions');
      sheet.getRange(1, 1, 1, 10).setValues([[
        'ID', 'Round', 'Category', 'Difficulty', 'Question', 'OptionA', 'OptionB', 'OptionC', 'CorrectOption', 'MediaUrl'
      ]]).setFontWeight('bold').setBackground('#e2e8f0');
      sheet.setFrozenRows(1);
    } else {
      ensureQuestionsMediaHeaderIfMissing(sheet);
    }

    const startRow = sheet.getLastRow() + 1;
    let currentId = getNextUniqueQuestionId(sheet) - 1;

    const formattedRows = importedRows
      .filter(item => cleanArabicLabel(item.question, '') !== '')
      .map(item => {
        currentId++;
        return [
          currentId,
          sanitizeForSheet(cleanArabicLabel(item.round, 'الجولة 1')),
          sanitizeForSheet(cleanArabicLabel(item.category, 'عام')),
          normalizeDifficulty(item.difficulty),
          sanitizeForSheet(cleanArabicLabel(item.question, '')),
          sanitizeForSheet(cleanArabicLabel(item.optA, '')),
          sanitizeForSheet(cleanArabicLabel(item.optB, '')),
          sanitizeForSheet(cleanArabicLabel(item.optC, '')),
          cleanArabicLabel(item.correct, 'A').toUpperCase(),
          sanitizeForSheet(cleanArabicLabel(item.mediaUrl, ''))
        ];
      });

    if (formattedRows.length === 0) return { status: 'EMPTY' };

    sheet.getRange(startRow, 1, formattedRows.length, 10).setValues(formattedRows);
    const updatedState = bumpQuestionsVersion();
    return { status: 'OK', importedCount: formattedRows.length, state: sanitizeStateForClient(updatedState) };
  } finally {
    lock.releaseLock();
  }
}