      state.boardNotice = `اكتملت أسئلة (${selCat} - ${selDiff})! اختر فئة وصعوبة جديدة.`;
      state.selectedCategory = null;
      state.selectedDifficulty = null;
      rebuildStateBoardSnapshot(state, allQ);
      persistLiveState(state);
      return { status: 'SLOT_EXHAUSTED', state: sanitizeStateForClient(state) };
    }
  } else {
    nextQ = allQ.find(q =>
      !used.includes(Number(q.id)) &&
      (activeRound === 'ALL' || cleanArabicLabel(q.round, 'الجولة 1') === activeRound)
    );

    if (!nextQ) {
