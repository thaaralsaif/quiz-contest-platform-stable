function togglePauseTimer() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const perm = assertHostPermission(state, 'permTimerControl', 'صلاحية التحكم بالمؤقت معطلة في إعدادات البطولة');
    if (!perm.allowed) return { status: 'FORBIDDEN', message: perm.message };

    const now = Date.now();

    if (!['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState)) {
      return { status: 'INVALID_STATE', message: 'لا يوجد مؤقت نشط حالياً للإيقاف أو الاستئناف' };
    }

    if (!state.isTimerPaused) {
      state.isTimerPaused = true;
      if (state.fsmState === 'QUESTION_ACTIVE' && state.questionEndTime) {
        state.pausedRemaining = Math.max(1, Math.ceil((state.questionEndTime - now) / 1000));
        state.questionEndTime = null;
        if (state.activeQuestionStartedAt) {
          state.accumulatedActiveMs = (Number(state.accumulatedActiveMs) || 0) + Math.max(0, now - Number(state.activeQuestionStartedAt));
          state.activeQuestionStartedAt = null;
        }
      } else if (state.fsmState === 'BUZZER_LOCKED' && state.answerEndTime) {
        state.pausedAnswerRemaining = Math.max(1, Math.ceil((state.answerEndTime - now) / 1000));
        state.answerEndTime = null;
      }
      state.refereeNotice = { text: '⏸️ أوقف المذيع المؤقت والوسائط مؤقتاً بقرار تحكيمي', at: now };
    } else {
      state.isTimerPaused = false;
      if (state.fsmState === 'QUESTION_ACTIVE') {
        const rem = Math.max(1, Number(state.pausedRemaining) || Number(state.settings.timerSeconds) || 25);
        state.questionEndTime = now + (rem * 1000);
        state.activeQuestionStartedAt = now;
      } else if (state.fsmState === 'BUZZER_LOCKED') {
        const defaultAns = resolveAnswerDurationSeconds(state, state.currentQuestion);
        const ansRem = Math.max(1, Number(state.pausedAnswerRemaining) || defaultAns);
        state.answerEndTime = now + (ansRem * 1000);
      }
      state.refereeNotice = { text: '▶️ استأنف المذيع المؤقت واستقبال المنافسة', at: now };
    }

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

