function computeNextTurnTeamId(state) {
  const count = Number(state.settings.teamCount) || 4;
  const eliminated = state.eliminatedTeams || [];
  let current = Number(state.activeTurnTeamId) || 1;

  for (let step = 1; step <= count; step++) {
    const candidate = ((current - 1 + step) % count) + 1;
    const candStr = String(candidate);
    if (!eliminated.includes(candStr)) {
      return candStr;
    }
  }
  return '1';
}

