// 20. قفل الضاغط بالمللي ثانية + مؤقت الإجابة المرن (5 - 60ث أو حسب الصعوبة)
function triggerBuzzer(teamId) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2000)) return { accepted: false, reason: 'LOCK_CONTENTION' };
  try {
    const state = getAuthoritativeGameState();
    const tId = String(teamId);
    const now = Date.now();
    const eff = state.activeEffects || {};

    if (state.activeResponseMode === 'SILENT_CHOICE') {
      return { accepted: false, reason: 'SILENT_CHOICE_ACTIVE', state: sanitizeStateForClient(state, tId) };
    }
    if (state.isTimerPaused) {
      return { accepted: false, reason: 'TIMER_PAUSED', state: sanitizeStateForClient(state, tId) };
    }
    if (state.eliminatedTeams && state.eliminatedTeams.includes(tId)) {
      return { accepted: false, reason: 'ELIMINATED', state: sanitizeStateForClient(state, tId) };
    }
    if (state.attemptedTeamsThisQuestion && state.attemptedTeamsThisQuestion.includes(tId)) {
      return { accepted: false, reason: 'ALREADY_ATTEMPTED', state: sanitizeStateForClient(state, tId) };
    }
    const frozenUntil = (eff.frozenTeams && Number(eff.frozenTeams[tId])) || 0;
    if (frozenUntil > now || (eff.freezeTargetTeam === tId && now < Number(eff.freezeUntil || 0))) {
      return { accepted: false, reason: 'FROZEN', state: sanitizeStateForClient(state, tId) };
    }
    if (state.fsmState !== 'QUESTION_ACTIVE' || state.lockedTeamId !== null) {
      return { accepted: false, lockedBy: state.lockedTeamId, reason: 'ALREADY_LOCKED', state: sanitizeStateForClient(state, tId) };
    }
    if (state.questionEndTime && now > state.questionEndTime + 350) {
      return { accepted: false, reason: 'TIME_EXPIRED', state: sanitizeStateForClient(state, tId) };
    }

    const remaining = state.questionEndTime ? Math.max(3, Math.ceil((state.questionEndTime - now) / 1000)) : 10;
    const answerSec = resolveAnswerDurationSeconds(state, state.currentQuestion);
    const elapsedMs = (Number(state.accumulatedActiveMs) || 0) + Math.max(1, now - Number(state.activeQuestionStartedAt || now));

    recordBuzzerTelemetry(state, tId, elapsedMs);

    state.accumulatedActiveMs = elapsedMs;
    state.activeQuestionStartedAt = null;
    state.fsmState = 'BUZZER_LOCKED';
    state.lockedTeamId = tId;
    state.timedOutTeamId = null;
    state.pausedRemaining = remaining;
    state.questionEndTime = null;
    state.currentAnswerDurationSec = answerSec;
    state.pausedAnswerRemaining = answerSec;
    state.answerEndTime = now + (answerSec * 1000);

    persistLiveState(state);
    return { accepted: true, lockedBy: tId, elapsedMs: elapsedMs, answerSec: answerSec, state: sanitizeStateForClient(state, tId) };
  } finally {
    lock.releaseLock();
  }
}

function triggerAnswerTimeout() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const now = Date.now();
    if (state.fsmState !== 'BUZZER_LOCKED' || !state.lockedTeamId) {
      return { status: 'NOT_LOCKED', state: sanitizeStateForClient(state) };
    }
    if (state.isTimerPaused) {
      return { status: 'PAUSED', state: sanitizeStateForClient(state) };
    }
    if (state.answerEndTime && now < state.answerEndTime - 250) {
      return { status: 'TOO_EARLY', state: sanitizeStateForClient(state) };
    }

    const timedOutId = String(state.lockedTeamId);
    const attempted = Array.isArray(state.attemptedTeamsThisQuestion) ? state.attemptedTeamsThisQuestion : [];
    if (!attempted.includes(timedOutId)) attempted.push(timedOutId);

    // تسجيل انتهاء الوقت كمحاولة غير موفقة لكسر سلسلة الانتصارات
    recordAnswerTelemetry(state, timedOutId, false, null);

    state.attemptedTeamsThisQuestion = attempted;
    state.timedOutTeamId = timedOutId;
    state.fsmState = 'ANSWER_TIMEOUT';
    state.answerEndTime = null;
    state.pausedAnswerRemaining = 0;

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

// 21. المرحلة الثالثة: الإجابة السرية الجماعية (Silent Mobile Choice) + دعم السرعة وقواعد الفوز
function submitSilentChoice(teamId, chosenOption) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { accepted: false, reason: 'LOCK_CONTENTION' };
  try {
    const state = getAuthoritativeGameState();
    const tId = String(teamId);
    const now = Date.now();
    const count = Number(state.settings.teamCount) || 4;
    const opt = cleanArabicLabel(chosenOption, '').toUpperCase();
    const eff = state.activeEffects || {};

    if (state.activeResponseMode !== 'SILENT_CHOICE' || state.fsmState !== 'QUESTION_ACTIVE') {
      return { accepted: false, reason: 'INVALID_STATE', state: sanitizeStateForClient(state, tId) };
    }
    if (state.isTimerPaused) {
      return { accepted: false, reason: 'TIMER_PAUSED', state: sanitizeStateForClient(state, tId) };
    }
    if (Number(tId) < 1 || Number(tId) > count) {
      return { accepted: false, reason: 'INVALID_TEAM', state: sanitizeStateForClient(state, tId) };
    }
    if (state.eliminatedTeams && state.eliminatedTeams.includes(tId)) {
      return { accepted: false, reason: 'ELIMINATED', state: sanitizeStateForClient(state, tId) };
    }
    const frozenUntil = (eff.frozenTeams && Number(eff.frozenTeams[tId])) || 0;
    if (frozenUntil > now || (eff.freezeTargetTeam === tId && now < Number(eff.freezeUntil || 0))) {
      return { accepted: false, reason: 'FROZEN', state: sanitizeStateForClient(state, tId) };
    }
    if (state.questionEndTime && now > state.questionEndTime + 350) {
      return { accepted: false, reason: 'TIME_EXPIRED', state: sanitizeStateForClient(state, tId) };
    }
    if (!['A', 'B', 'C'].includes(opt)) {
      return { accepted: false, reason: 'INVALID_OPTION', state: sanitizeStateForClient(state, tId) };
    }
    if (Array.isArray(eff.eliminatedOptions) && eff.eliminatedOptions.includes(opt)) {
      return { accepted: false, reason: 'OPTION_ELIMINATED', state: sanitizeStateForClient(state, tId) };
    }

    const secretChoices = getSecretChoicesMap();
    if (secretChoices[tId]) {
      return {
        accepted: false,
        reason: 'ALREADY_VOTED',
        mySecretChoice: secretChoices[tId].choice,
        state: sanitizeStateForClient(state, tId)
      };
    }

    const elapsedMs = (Number(state.accumulatedActiveMs) || 0) + Math.max(1, now - Number(state.activeQuestionStartedAt || now));
    secretChoices[tId] = {
      choice: opt,
      submittedAt: now,
      elapsedMs: elapsedMs
    };
    persistSecretChoicesMap(secretChoices);

    const voted = Array.isArray(state.votedTeams) ? state.votedTeams.slice() : [];
    if (!voted.includes(tId)) voted.push(tId);
    state.votedTeams = voted;

    persistLiveState(state);
    return {
      accepted: true,
      mySecretChoice: opt,
      state: sanitizeStateForClient(state, tId)
    };
  } finally {
    lock.releaseLock();
  }
}

function closeSilentVoting(isManual) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const now = Date.now();

    if (state.fsmState === 'CHOICE_REVEALED') {
      return { status: 'ALREADY_REVEALED', state: sanitizeStateForClient(state) };
    }
    if (state.activeResponseMode !== 'SILENT_CHOICE' || state.fsmState !== 'QUESTION_ACTIVE') {
      return { status: 'INVALID_STATE', state: sanitizeStateForClient(state) };
    }
    if (!isManual) {
      if (state.isTimerPaused) {
        return { status: 'PAUSED', state: sanitizeStateForClient(state) };
      }
      if (state.questionEndTime && now < state.questionEndTime - 250) {
        return { status: 'TOO_EARLY', state: sanitizeStateForClient(state) };
      }
    }

    const secretChoices = getSecretChoicesMap();
    saveUndoSnapshot(state, 'كشف وتقييم جولة الإجابة السرية الجماعية', secretChoices);

    const correctOpt = state.currentQuestion ? cleanArabicLabel(state.currentQuestion.correct, 'A').toUpperCase() : 'A';
    const basePts = Number(state.currentQuestionPoints) || Number(state.settings.pointsEasy) || 100;
    const penaltyPts = Number(state.settings.pointsWrongPenalty) || 0;
    const count = Number(state.settings.teamCount) || 4;
    const eliminated = state.eliminatedTeams || [];
    const eff = state.activeEffects || getEmptyEffects();

    const revealed = {};
    const stealQueue = [];

    for (let i = 1; i <= count; i++) {
      const id = String(i);
      if (eliminated.includes(id)) continue;

      const vote = secretChoices[id];
      if (!vote || !vote.choice) {
        revealed[id] = {
          choice: null,
          status: 'NO_VOTE',
          isCorrect: false,
          delta: 0,
          speedBonus: 0,
          stolenAmount: 0,
          victimId: null,
          elapsedMs: null
        };
        continue;
      }

      const isCorrect = (vote.choice === correctOpt);
      const hasDouble = (eff.doubleTeams || []).includes(id) || eff.doubleTeam === id;
      const hasShield = (eff.shieldTeams || []).includes(id) || eff.shieldTeam === id;
      let delta = 0;
      let speedBonus = 0;

      if (isCorrect) {
        const calc = calculateAwardedPoints(basePts, vote.elapsedMs, state.settings);
        speedBonus = calc.speedBonus;
        const multiplier = hasDouble ? 2 : 1;
        delta = calc.totalPoints * multiplier;
        state.scores[id] = (Number(state.scores[id]) || 0) + delta;

        const targetVictim = (eff.stealTargets && eff.stealTargets[id]) || (eff.stealTeam === id ? findLeadingTeamId(state, id) : null);
        if (targetVictim) {
          stealQueue.push({ thiefId: id, victimId: targetVictim });
        }
      } else if (!hasShield && penaltyPts > 0) {
        const before = Number(state.scores[id]) || 0;
        const after = Math.max(0, before - penaltyPts);
        delta = after - before;
        state.scores[id] = after;
      }

      recordAnswerTelemetry(state, id, isCorrect, vote.elapsedMs);
      revealed[id] = {
        choice: vote.choice,
        status: isCorrect ? 'CORRECT' : 'WRONG',
        isCorrect: isCorrect,
        delta: delta,
        speedBonus: speedBonus,
        stolenAmount: 0,
        victimId: null,
        usedDouble: isCorrect && hasDouble,
        usedShield: !isCorrect && hasShield,
        elapsedMs: vote.elapsedMs || null
      };
    }

    stealQueue.forEach(item => {
      const victimScore = Number(state.scores[item.victimId]) || 0;
      if (victimScore > 0 && !eliminated.includes(item.victimId) && item.victimId !== item.thiefId) {
        const stolen = Math.min(victimScore, Math.floor(basePts / 2));
        if (stolen > 0) {
          state.scores[item.victimId] = victimScore - stolen;
          state.scores[item.thiefId] = (Number(state.scores[item.thiefId]) || 0) + stolen;
          if (revealed[item.thiefId]) {
            revealed[item.thiefId].delta += stolen;
            revealed[item.thiefId].stolenAmount = stolen;
            revealed[item.thiefId].victimId = item.victimId;
          }
        }
      }
    });

    clearSecretChoicesMap();
    state.questionsCompletedCount = (Number(state.questionsCompletedCount) || 0) + 1;
    state.revealedChoices = revealed;
    state.fsmState = 'CHOICE_REVEALED';
    state.questionEndTime = null;
    state.answerEndTime = null;
    state.isTimerPaused = false;
    state.activeQuestionStartedAt = null;
    state.activeTurnTeamId = computeNextTurnTeamId(state);

    // فحص شروط إنهاء المباراة المدمجة (هدف الإجابات / حد الأسئلة / انتهاء الوقت)
    const term = checkAndApplyMatchTermination(state, now, true);
    if (term.terminated) {
      persistLiveState(state);
      return { status: 'OK', matchEnded: true, state: sanitizeStateForClient(state) };
    }

    const mode = state.settings.playMode || 'BOARD';
    if (mode === 'BOARD') {
      state.autoTransitionAction = 'RETURN_TO_BOARD';
      state.autoTransitionAt = now + 5500;
    } else if (mode === 'AUTO_CATEGORY') {
      state.autoTransitionAction = 'NEXT_IN_SLOT';
      state.autoTransitionAt = now + 5500;
    } else if (mode === 'AUTO_ALL') {
      state.selectedCategory = null;
      state.selectedDifficulty = null;
      state.autoTransitionAction = 'NEXT_IN_ALL';
      state.autoTransitionAt = now + 5500;
    } else {
      state.autoTransitionAction = null;
      state.autoTransitionAt = null;
    }

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

// 22. تفعيل الأدوات التكتيكية المستقلة الستة مع التحقق من بوابة الفتح (powerUpUnlockCondition)
function activatePowerUp(teamId, type, targetTeamId) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2500)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const tId = String(teamId);
    const now = Date.now();

    const gate = evaluatePowerUpGateForTeam(state, tId);
    if (!gate.unlocked) {
      return { status: 'GATE_LOCKED', message: gate.reason || 'لم يتحقق شرط تفعيل الأدوات لفريقك بعد' };
    }

    if (state.eliminatedTeams && state.eliminatedTeams.includes(tId)) {
      return { status: 'ELIMINATED', message: 'فريقك مستبعد في هذه الجولة' };
    }
    const currentUses = (state.powerUps[tId] && Number(state.powerUps[tId][type])) || 0;
    if (currentUses <= 0) {
      return { status: 'UNAVAILABLE', message: 'نفد رصيد هذه الأداة لفريقك' };
    }
    if (!['QUESTION_ACTIVE', 'BUZZER_LOCKED'].includes(state.fsmState)) {
      return { status: 'INVALID_STATE', message: 'لا يمكن تفعيل الأداة إلا أثناء عرض السؤال' };
    }
    if (
      state.activeResponseMode === 'SILENT_CHOICE' &&
      Array.isArray(state.votedTeams) &&
      state.votedTeams.includes(tId) &&
      type !== 'time'
    ) {
      return { status: 'ALREADY_VOTED', message: 'لا يمكن تفعيل هذه الأداة بعد تثبيت اختيارك السري' };
    }
    if (state.fsmState === 'BUZZER_LOCKED') {
      if (['freeze', 'time'].includes(type)) {
        return { status: 'BUZZER_ALREADY_LOCKED', message: 'تم قفل الضاغط بالفعل؛ لا حاجة للتجميد أو الوقت الإضافي' };
      }
      if (state.lockedTeamId !== tId) {
        return { status: 'NOT_YOUR_TURN', message: 'فريق آخر سبقكم بالضغط على الضاغط' };
      }
    }

    if (!state.activeEffects) state.activeEffects = getEmptyEffects();
    const eff = state.activeEffects;
    if (!Array.isArray(eff.shieldTeams)) eff.shieldTeams = eff.shieldTeam ? [eff.shieldTeam] : [];
    if (!Array.isArray(eff.doubleTeams)) eff.doubleTeams = eff.doubleTeam ? [eff.doubleTeam] : [];
    if (!eff.stealTargets || typeof eff.stealTargets !== 'object') eff.stealTargets = {};
    if (!eff.frozenTeams || typeof eff.frozenTeams !== 'object') eff.frozenTeams = {};

    const teamName = state.settings[`team${tId}Name`] || `فريق ${tId}`;
    let bannerMsg = '';

    if (type === 'shield') {
      if (eff.shieldTeams.includes(tId)) return { status: 'ALREADY_ACTIVE', message: 'الدرع مفعّل لفريقك بالفعل في هذا السؤال' };
      eff.shieldTeams.push(tId);
      eff.shieldTeam = tId;
      bannerMsg = `🛡️ فريق (${teamName}) فعّل درع الحماية ضد الخصم!`;
    } else if (type === 'double') {
      if (eff.doubleTeams.includes(tId)) return { status: 'ALREADY_ACTIVE', message: 'المضاعفة مفعّلة لفريقك بالفعل في هذا السؤال' };
      eff.doubleTeams.push(tId);
      eff.doubleTeam = tId;
      bannerMsg = `🚀 فريق (${teamName}) فعّل صاروخ مضاعفة النقاط ×2!`;
    } else if (type === 'steal') {
      if (eff.stealTargets[tId]) return { status: 'ALREADY_ACTIVE', message: 'أداة السرقة مفعّلة لفريقك بالفعل في هذا السؤال' };
      const count = Number(state.settings.teamCount) || 4;
      let victimId = targetTeamId ? String(targetTeamId) : findLeadingTeamId(state, tId);

      if (
        !victimId ||
        victimId === tId ||
        Number(victimId) < 1 ||
        Number(victimId) > count ||
        (state.eliminatedTeams && state.eliminatedTeams.includes(victimId)) ||
        (Number(state.scores[victimId]) || 0) <= 0
      ) {
        return { status: 'NO_TARGET', message: 'الفريق المختار لا يملك رصيداً أكبر من صفر أو غير متاح للسرقة' };
      }

      const victimName = state.settings[`team${victimId}Name`] || `فريق ${victimId}`;
      eff.stealTargets[tId] = victimId;
      eff.stealTeam = tId;
      bannerMsg = `🧲 فريق (${teamName}) استهدف (${victimName}) بأداة سرقة النقاط!`;
    } else if (type === 'ai') {
      if (!state.currentQuestion) return { status: 'NO_QUESTION', message: 'لا يوجد سؤال نشط' };
      const correct = state.currentQuestion.correct;
      const alreadyElim = eff.eliminatedOptions || [];
      const availableWrong = ['A', 'B', 'C'].filter(opt => opt !== correct && !alreadyElim.includes(opt));
      if (availableWrong.length === 0) {
        return { status: 'NO_MORE_WRONG', message: 'تم حذف جميع الخيارات الخاطئة مسبقاً' };
      }
      alreadyElim.push(availableWrong[0]);
      eff.eliminatedOptions = alreadyElim;
      bannerMsg = `✨ فريق (${teamName}) استخدم المساعد الذكي وحذف إجابة خاطئة!`;
    } else if (type === 'time') {
      if (state.fsmState === 'QUESTION_ACTIVE') {
        if (state.isTimerPaused || !state.questionEndTime) {
          state.pausedRemaining = (Number(state.pausedRemaining) || 10) + 15;
        } else {
          state.questionEndTime += 15000;
        }
      } else {
        state.pausedRemaining = (Number(state.pausedRemaining) || 10) + 15;
      }
      bannerMsg = `⏳ فريق (${teamName}) أضاف +15 ثانية إضافية للمؤقت!`;
    } else if (type === 'freeze') {
      const leaderId = findLeadingTeamId(state, tId);
      if (!leaderId) {
        return { status: 'NO_TARGET', message: 'لا يوجد فريق متصدر برصيد نقاط لتجميده حالياً' };
      }
      const existingEnd = Number(eff.frozenTeams[leaderId]) || 0;
      if (existingEnd > now) {
        return { status: 'ALREADY_FROZEN', message: 'الفريق المتصدر مجمد بالفعل حالياً' };
      }
      const leaderName = state.settings[`team${leaderId}Name`] || `فريق ${leaderId}`;
      const freezeEnd = now + 8000;
      eff.frozenTeams[leaderId] = freezeEnd;
      eff.freezeTargetTeam = leaderId;
      eff.freezeUntil = freezeEnd;
      bannerMsg = `❄️ فريق (${teamName}) جمّد (${leaderName}) لمدة 8 ثوانٍ!`;
    } else {
      return { status: 'UNKNOWN_TYPE', message: 'أداة غير معروفة' };
    }

    state.powerUps[tId][type] = currentUses - 1;
    eff.lastPowerUpBanner = bannerMsg;
    recordPowerUpTelemetry(state, tId);

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state, tId) };
  } finally {
    lock.releaseLock();
  }
}

function findLeadingTeamId(state, excludeTeamId) {
  const count = Number(state.settings.teamCount) || 4;
  let bestTeam = null;
  let maxScore = 0;
  for (let i = 1; i <= count; i++) {
    const id = String(i);
    if (id === String(excludeTeamId)) continue;
    if (state.eliminatedTeams && state.eliminatedTeams.includes(id)) continue;
    const sc = Number(state.scores[id]) || 0;
    if (sc > maxScore) {
      maxScore = sc;
      bestTeam = id;
    }
  }
  return bestTeam;
}

// 23. تقييم الإجابة + احتساب السرعة + فحص شروط الفوز المدمجة
function evaluateAnswer(isCorrect) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const team = state.lockedTeamId;
    const now = Date.now();
    if (!team) return { status: 'NO_TEAM' };
    if (['ANSWER_CORRECT', 'ANSWER_WRONG', 'CHOICE_REVEALED'].includes(state.fsmState)) {
      return { status: 'ALREADY_EVALUATED', state: sanitizeStateForClient(state) };
    }

    const teamName = state.settings[`team${team}Name`] || `فريق ${team}`;
    saveUndoSnapshot(state, `${isCorrect ? 'إجابة صحيحة' : 'إجابة خاطئة'} — ${teamName}`, null);

    const eff = state.activeEffects || getEmptyEffects();
    const basePts = Number(state.currentQuestionPoints) || Number(state.settings.pointsEasy) || 100;
    const penaltyPts = Number(state.settings.pointsWrongPenalty) || 0;
    const currentScore = Number(state.scores[team]) || 0;
    const attempted = Array.isArray(state.attemptedTeamsThisQuestion) ? state.attemptedTeamsThisQuestion : [];
    if (!attempted.includes(team)) attempted.push(team);
    state.attemptedTeamsThisQuestion = attempted;

    state.lastStealSummary = null;
    state.lastSpeedBonusAwarded = 0;
    state.answerEndTime = null;
    state.isTimerPaused = false;

    if (isCorrect) {
      const calc = calculateAwardedPoints(basePts, state.accumulatedActiveMs, state.settings);
      state.lastSpeedBonusAwarded = calc.speedBonus;
      const hasDouble = (eff.doubleTeams || []).includes(team) || eff.doubleTeam === team;
      const multiplier = hasDouble ? 2 : 1;
      let earned = calc.totalPoints * multiplier;

      const targetVictim = (eff.stealTargets && eff.stealTargets[team]) || (eff.stealTeam === team ? findLeadingTeamId(state, team) : null);
      if (targetVictim && targetVictim !== team && !(state.eliminatedTeams || []).includes(targetVictim)) {
        const victimScore = Number(state.scores[targetVictim]) || 0;
        if (victimScore > 0) {
          const stolen = Math.min(victimScore, Math.floor(basePts / 2));
          state.scores[targetVictim] = victimScore - stolen;
          earned += stolen;
          state.lastStealSummary = {
            thiefId: team,
            thiefName: teamName,
            victimId: targetVictim,
            victimName: state.settings[`team${targetVictim}Name`] || `فريق ${targetVictim}`,
            amount: stolen
          };
        }
      }

      state.scores[team] = currentScore + earned;
      state.fsmState = 'ANSWER_CORRECT';
      state.questionsCompletedCount = (Number(state.questionsCompletedCount) || 0) + 1;
    } else {
      const hasShield = (eff.shieldTeams || []).includes(team) || eff.shieldTeam === team;
      if (!hasShield && penaltyPts > 0) {
        state.scores[team] = Math.max(0, currentScore - penaltyPts);
      }
      state.fsmState = 'ANSWER_WRONG';
      // إذا استنفدت جميع الفرق النشطة محاولاتها، نعتبر السؤال مكتملاً
      const count = Number(state.settings.teamCount) || 4;
      const eliminated = state.eliminatedTeams || [];
      let remainingEligible = 0;
      for (let i = 1; i <= count; i++) {
        const id = String(i);
        if (!eliminated.includes(id) && !attempted.includes(id)) remainingEligible++;
      }
      if (remainingEligible === 0) {
        state.questionsCompletedCount = (Number(state.questionsCompletedCount) || 0) + 1;
      }
    }

    recordAnswerTelemetry(state, team, Boolean(isCorrect), null);
    state.activeTurnTeamId = computeNextTurnTeamId(state);

    // إذا كنا في سؤال ذهبي لكسر التعادل وأجاب الفريق إجابة صحيحة، يُحسم اللقب فوراً
    if (isCorrect && state.isSuddenDeathTieBreaker) {
      finalizeMatchToPodium(
        state,
        'GOLDEN_QUESTION_WON',
        `🏆 حسم فريق (${teamName}) السؤال الذهبي الفاصل وتُوج بطلاً للمسابقة!`
      );
      persistLiveState(state);
      return { status: 'OK', matchEnded: true, state: sanitizeStateForClient(state) };
    }

    // فحص شروط إنهاء المباراة المدمجة (هدف الإجابات الصحيحة / حد الأسئلة / انتهاء الوقت)
    const isCompletedQuestion = (isCorrect || state.autoTransitionAction !== null || (Number(state.questionsCompletedCount) > 0 && isCorrect));
    const term = checkAndApplyMatchTermination(state, now, Boolean(isCorrect || isCompletedQuestion));
    if (term.terminated) {
      persistLiveState(state);
      return { status: 'OK', matchEnded: true, state: sanitizeStateForClient(state) };
    }

    const mode = state.settings.playMode || 'BOARD';
    if (mode === 'BOARD') {
      state.autoTransitionAction = 'RETURN_TO_BOARD';
      state.autoTransitionAt = now + 3500;
    } else if (mode === 'AUTO_CATEGORY') {
      state.autoTransitionAction = 'NEXT_IN_SLOT';
      state.autoTransitionAt = now + 3500;
    } else if (mode === 'AUTO_ALL') {
      state.selectedCategory = null;
      state.selectedDifficulty = null;
      state.autoTransitionAction = 'NEXT_IN_ALL';
      state.autoTransitionAt = now + 3500;
    } else {
      state.autoTransitionAction = null;
      state.autoTransitionAt = null;
    }

    persistLiveState(state);
    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

// 24. حارس صلاحيات المذيع التحكيمية (Server-Side Permission Enforcement)
function assertHostPermission(state, permKey, deniedMsg) {
  const s = (state && state.settings) || {};
  if (s[permKey] === false || String(s[permKey]).toLowerCase() === 'false') {
    return { allowed: false, message: deniedMsg || 'هذه الصلاحية معطلة في إعدادات هذه البطولة' };
  }
  return { allowed: true };
}

function undoLastEvaluation() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const perm = assertHostPermission(state, 'permUndo', 'صلاحية التراجع عن الحكم معطلة في إعدادات البطولة');
    if (!perm.allowed) return { status: 'FORBIDDEN', message: perm.message };

    const rawUndo = PropertiesService.getScriptProperties().getProperty(PROP_KEY_UNDO);
    if (!rawUndo) {
      return { status: 'NO_UNDO', message: 'لا يوجد حكم تحكيمي حديث للتراجع عنه' };
    }
    const snap = JSON.parse(rawUndo);

    state.scores = snap.scores || state.scores;
    state.powerUps = snap.powerUps || state.powerUps;
    state.activeEffects = snap.activeEffects || getEmptyEffects();
    state.activeTurnTeamId = snap.activeTurnTeamId || state.activeTurnTeamId;
    state.currentQuestion = snap.currentQuestion || state.currentQuestion;
    state.currentQuestionPoints = snap.currentQuestionPoints || state.currentQuestionPoints;
    state.attemptedTeamsThisQuestion = snap.attemptedTeamsThisQuestion || [];
    state.questionsCompletedCount = Number(snap.questionsCompletedCount) || 0;
    state.isSuddenDeathTieBreaker = Boolean(snap.isSuddenDeathTieBreaker);
    state.activeResponseMode = snap.activeResponseMode || 'BUZZER';
    state.votedTeams = snap.votedTeams || [];
    state.revealedChoices = null;
    if (snap.telemetry) state.telemetry = snap.telemetry;
    state.autoTransitionAction = null;
    state.autoTransitionAt = null;
    state.lastStealSummary = null;
    state.lastSpeedBonusAwarded = 0;
    state.isTimerPaused = false;

    const now = Date.now();
    if (state.activeResponseMode === 'SILENT_CHOICE') {
      if (snap.secretChoicesSnapshot) {
        persistSecretChoicesMap(snap.secretChoicesSnapshot);
      }
      const rem = Math.max(8, Number(snap.pausedRemaining) || 15);
      state.fsmState = 'QUESTION_ACTIVE';
      state.lockedTeamId = null;
      state.timedOutTeamId = null;
      state.questionEndTime = now + (rem * 1000);
      state.answerEndTime = null;
      state.activeQuestionStartedAt = now;
    } else {
      state.fsmState = 'BUZZER_LOCKED';
      state.lockedTeamId = snap.lockedTeamId || null;
      state.timedOutTeamId = null;
      const ansSec = resolveAnswerDurationSeconds(state, state.currentQuestion);
      state.currentAnswerDurationSec = ansSec;
      state.pausedAnswerRemaining = ansSec;
      state.answerEndTime = state.lockedTeamId ? (now + ansSec * 1000) : null;
    }

    state.refereeNotice = {
      text: `↩️ تراجع المذيع عن آخر حكم تحكيمي (${snap.summary})`,
      at: now
    };
    clearUndoSnapshot(state);

    persistLiveState(state);
    return { status: 'OK', message: '↩️ تم التراجع عن آخر حكم تحكيمي واستعادة النقاط والإحصائيات بنجاح', state: sanitizeStateForClient(state) };
