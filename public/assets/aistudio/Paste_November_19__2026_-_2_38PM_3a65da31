// 8. محرك الإحصائيات والقياس اللحظي (Telemetry & Streaks)
function buildInitialTelemetry() {
  const perTeam = {};
  for (let i = 1; i <= MAX_TEAMS; i++) {
    perTeam[String(i)] = {
      buzzCount: 0,
      fastestBuzzMs: null,
      totalResponseMs: 0,
      responseSamples: 0,
      correctCount: 0,
      wrongCount: 0,
      attemptedCount: 0,
      currentStreak: 0,
      bestStreak: 0,
      powerUpsUsed: 0
    };
  }
  return {
    fastestBuzz: { teamId: null, elapsedMs: null, questionId: null },
    perTeam: perTeam
  };
}

function ensureTelemetryStructure(state) {
  if (!state.telemetry || typeof state.telemetry !== 'object') {
    state.telemetry = buildInitialTelemetry();
    return;
  }
  if (!state.telemetry.fastestBuzz) {
    state.telemetry.fastestBuzz = { teamId: null, elapsedMs: null, questionId: null };
  }
  if (!state.telemetry.perTeam) {
    state.telemetry.perTeam = {};
  }
  for (let i = 1; i <= MAX_TEAMS; i++) {
    const id = String(i);
    const cur = state.telemetry.perTeam[id] || {};
    state.telemetry.perTeam[id] = {
      buzzCount: Number(cur.buzzCount) || 0,
      fastestBuzzMs: cur.fastestBuzzMs !== undefined ? cur.fastestBuzzMs : null,
      totalResponseMs: Number(cur.totalResponseMs) || 0,
      responseSamples: Number(cur.responseSamples) || 0,
      correctCount: Number(cur.correctCount) || 0,
      wrongCount: Number(cur.wrongCount) || 0,
      attemptedCount: Number(cur.attemptedCount) || 0,
      currentStreak: Number(cur.currentStreak) || 0,
      bestStreak: Number(cur.bestStreak) || 0,
      powerUpsUsed: Number(cur.powerUpsUsed) || 0
    };
  }
}

function recordBuzzerTelemetry(state, teamId, elapsedMs) {
  ensureTelemetryStructure(state);
  const tId = String(teamId);
  const entry = state.telemetry.perTeam[tId];
  const ms = Math.max(1, Math.round(Number(elapsedMs) || 1));

  entry.buzzCount += 1;
  entry.totalResponseMs += ms;
  entry.responseSamples += 1;

  if (entry.fastestBuzzMs === null || ms < Number(entry.fastestBuzzMs)) {
    entry.fastestBuzzMs = ms;
  }

  const globalBest = state.telemetry.fastestBuzz;
  if (globalBest.elapsedMs === null || ms < Number(globalBest.elapsedMs)) {
    state.telemetry.fastestBuzz = {
      teamId: tId,
      elapsedMs: ms,
      questionId: state.currentQuestion ? Number(state.currentQuestion.id) : null
    };
  }
}

function recordAnswerTelemetry(state, teamId, isCorrect, optionalResponseMs) {
  ensureTelemetryStructure(state);
  const tId = String(teamId);
  const entry = state.telemetry.perTeam[tId];
  entry.attemptedCount += 1;

  if (optionalResponseMs && Number(optionalResponseMs) > 0) {
    entry.totalResponseMs += Math.round(Number(optionalResponseMs));
    entry.responseSamples += 1;
  }

  if (isCorrect) {
    entry.correctCount += 1;
    entry.currentStreak += 1;
    if (entry.currentStreak > entry.bestStreak) {
      entry.bestStreak = entry.currentStreak;
    }
  } else {
    entry.wrongCount += 1;
    entry.currentStreak = 0;
  }
}

function recordPowerUpTelemetry(state, teamId) {
  ensureTelemetryStructure(state);
  const tId = String(teamId);
  state.telemetry.perTeam[tId].powerUpsUsed += 1;
}

function computeLiveTelemetrySummary(state) {
  ensureTelemetryStructure(state);
  const count = Number(state.settings && state.settings.teamCount) || 4;
  const perTeam = state.telemetry.perTeam;

  let fastest = null;
  if (state.telemetry.fastestBuzz && state.telemetry.fastestBuzz.teamId) {
    const fId = String(state.telemetry.fastestBuzz.teamId);
    if (Number(fId) <= count) {
      fastest = {
        teamId: fId,
        teamName: (state.settings && state.settings[`team${fId}Name`]) || `فريق ${fId}`,
        elapsedMs: Number(state.telemetry.fastestBuzz.elapsedMs)
      };
    }
  }

  let bestAcc = null;
  let topPu = null;
  for (let i = 1; i <= count; i++) {
    const id = String(i);
    const tName = (state.settings && state.settings[`team${id}Name`]) || `فريق ${id}`;
    const stats = perTeam[id] || {};
    const attempts = Number(stats.attemptedCount) || 0;
    const correct = Number(stats.correctCount) || 0;

    if (attempts > 0) {
      const pct = Math.round((correct / attempts) * 100);
      if (
        !bestAcc ||
        pct > bestAcc.accuracyPct ||
        (pct === bestAcc.accuracyPct && correct > bestAcc.correctCount)
      ) {
        bestAcc = { teamId: id, teamName: tName, accuracyPct: pct, correctCount: correct, attemptedCount: attempts };
      }
    }

    const puUsed = Number(stats.powerUpsUsed) || 0;
    if (puUsed > 0 && (!topPu || puUsed > topPu.count)) {
      topPu = { teamId: id, teamName: tName, count: puUsed };
    }
  }

  return {
    fastestBuzz: fastest,
    highestAccuracy: bestAcc,
    mostPowerUps: topPu
  };
}

// 9. محرك أولويات إنهاء المباراة وكسر التعادل (Hybrid Win-Condition Precedence Engine)
function getEffectiveMatchElapsedMs(state, nowTs) {
  const now = nowTs || Date.now();
  if (!state.matchStartedAt) return 0;
  let paused = Number(state.matchTotalPausedMs) || 0;
  if (state.isMatchClockPaused && state.matchClockPausedAt) {
    paused += Math.max(0, now - Number(state.matchClockPausedAt));
  }
  return Math.max(0, now - Number(state.matchStartedAt) - paused);
}

function getRankedActiveTeamsForStanding(state) {
  const s = state.settings || getDefaultSettingsObject();
  const count = Number(s.teamCount) || 4;
  const eliminated = state.eliminatedTeams || [];
  ensureTelemetryStructure(state);

  const list = [];
  for (let i = 1; i <= count; i++) {
    const id = String(i);
    if (eliminated.includes(id)) continue;
    const tStats = state.telemetry.perTeam[id] || {};
    const avgMs = tStats.responseSamples > 0
      ? Math.round(tStats.totalResponseMs / tStats.responseSamples)
      : Number.MAX_SAFE_INTEGER;
    list.push({
      id: id,
      name: s[`team${id}Name`] || `فريق ${id}`,
      score: Number((state.scores && state.scores[id]) || 0),
      correctCount: Number(tStats.correctCount) || 0,
      avgResponseMs: avgMs
    });
  }

  return list.sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    if (b.correctCount !== a.correctCount) return b.correctCount - a.correctCount;
    return a.avgResponseMs - b.avgResponseMs;
  });
}

function checkAndApplyMatchTermination(state, nowTs, isPostQuestionEvaluation) {
  const now = nowTs || Date.now();
  const s = state.settings || getDefaultSettingsObject();

  if (state.fsmState === 'CELEBRATION_PODIUM') {
    return { terminated: true, reason: state.matchEndReason || 'COMPLETED' };
  }

  // لا نقطع إجابة فريق ضغط الضاغط بالفعل؛ ننتظر تقييم إجابته أولاً
  if (!isPostQuestionEvaluation && state.fsmState === 'BUZZER_LOCKED') {
    return { terminated: false };
  }

  const targetCorrect = Number(s.targetCorrectAnswers) || 0;
  const maxQuestions = Number(s.maxQuestionsPerMatch) || 0;
  const durationMins = Number(s.matchDurationMinutes) || 0;

  // الشرط 1 (الأعلى أولوية): وصول أحد الفرق لعدد الإجابات الصحيحة المطلوب
  if (targetCorrect > 0) {
    ensureTelemetryStructure(state);
    const count = Number(s.teamCount) || 4;
    const eliminated = state.eliminatedTeams || [];
    for (let i = 1; i <= count; i++) {
      const id = String(i);
      if (eliminated.includes(id)) continue;
      const cCount = Number(state.telemetry.perTeam[id].correctCount) || 0;
      if (cCount >= targetCorrect) {
        const winnerName = s[`team${id}Name`] || `فريق ${id}`;
        finalizeMatchToPodium(
          state,
          'TARGET_CORRECT_REACHED',
          `🎯 حقق فريق (${winnerName}) هدف (${targetCorrect}) إجابات صحيحة وتُوج بالبطولة!`
        );
        return { terminated: true, reason: 'TARGET_CORRECT_REACHED' };
      }
    }
  }

  // الشرط 2: استهلاك الحد الأقصى للأسئلة المحددة للمسابقة (يُفحص بعد انتهاء السؤال)
  const completedQ = Number(state.questionsCompletedCount) || 0;
  const maxQuestionsHit = (isPostQuestionEvaluation && maxQuestions > 0 && completedQ >= maxQuestions);

  // الشرط 3: انتهاء المؤقت الكلي للمباراة (مثلاً ساعة كاملة)
  let timeExpiredHit = false;
  if (durationMins > 0 && state.matchStartedAt) {
    const durationMs = durationMins * 60 * 1000;
    const elapsedMs = getEffectiveMatchElapsedMs(state, now);
    if (elapsedMs >= durationMs) {
      timeExpiredHit = true;
    }
  }

  if (maxQuestionsHit || timeExpiredHit) {
    const ranked = getRankedActiveTeamsForStanding(state);
    const isTopTied = ranked.length >= 2 && ranked[0].score === ranked[1].score;

    // إذا كان خيار كسر التعادل هو السؤال الذهبي ولم نكن في سؤال ذهبي بالفعل
    if (isTopTied && s.tieBreakerRule === 'GOLDEN_QUESTION' && !state.isSuddenDeathTieBreaker) {
      state.isSuddenDeathTieBreaker = true;
      state.autoTransitionAction = null;
      state.autoTransitionAt = null;
      state.currentQuestion = null;
      state.questionEndTime = null;
      state.answerEndTime = null;
      state.fsmState = (s.playMode === 'BOARD' || s.playMode === 'AUTO_CATEGORY') ? 'CATEGORY_BOARD' : 'WAITING_LOBBY';
      const triggerText = timeExpiredHit ? 'انتهى وقت المباراة الرسمي' : `اكتمل عدد الأسئلة (${maxQuestions})`;
      state.boardNotice = `⚡ ${triggerText} بتعادل الصدارة (${ranked[0].name} و ${ranked[1].name})! اطرح السؤال الذهبي الفاصل لحسم اللقب!`;
      state.refereeNotice = { text: state.boardNotice, at: now };
      return { terminated: false, suddenDeath: true };
    }

    const reasonCode = timeExpiredHit ? 'MATCH_TIME_EXPIRED' : 'MAX_QUESTIONS_REACHED';
    const reasonLabel = timeExpiredHit
      ? `⏱️ انتهى الوقت الرسمي للمباراة (${durationMins} دقيقة) — إعلان الترتيب النهائي!`
      : `🏁 اكتمل العدد المحدد للأسئلة (${maxQuestions} سؤال) — إعلان الترتيب النهائي!`;

    finalizeMatchToPodium(state, reasonCode, reasonLabel);
    return { terminated: true, reason: reasonCode };
  }

  return { terminated: false };
}

function finalizeMatchToPodium(state, reasonCode, bannerText) {
  clearSecretChoicesMap();
  state.fsmState = 'CELEBRATION_PODIUM';
  state.matchEndReason = reasonCode;
  state.matchEndBanner = bannerText;
  state.currentQuestion = null;
  state.questionEndTime = null;
  state.answerEndTime = null;
  state.isTimerPaused = false;
  state.autoTransitionAction = null;
  state.autoTransitionAt = null;
  state.lockedTeamId = null;
  state.timedOutTeamId = null;
  state.votedTeams = [];
  state.revealedChoices = null;
  state.activeEffects = getEmptyEffects();
}

function buildFreshState(settings) {
  const s = sanitizeSettingsPayload(settings);
  const scores = {};
  for (let i = 1; i <= MAX_TEAMS; i++) {
    scores[String(i)] = 0;
  }

  const isBoardBased = (s.playMode === 'BOARD' || s.playMode === 'AUTO_CATEGORY');
  const initialFsm = isBoardBased ? 'CATEGORY_BOARD' : 'WAITING_LOBBY';
  const defaultAnsSec = resolveAnswerDurationSeconds({ settings: s }, null);
  const now = Date.now();

  return {
    stateRevision: 1,
    stateTimestamp: now,
    fsmState: initialFsm,
    activeTheme: 'luxury',
    customTokens: {},
    settings: s,
    questionsVersion: 1,
    totalQuestionsCount: 0,
    questionsCompletedCount: 0,
    boardMatrix: {},
    activeTurnTeamId: '1',
    selectedRound: 'ALL',
    selectedCategory: null,
    selectedDifficulty: null,
    usedQuestionIds: [],
    currentRoundLabel: 'جميع الجولات',
    currentQuestion: null,
    currentQuestionPoints: Number(s.pointsEasy) || 100,
    currentAnswerDurationSec: defaultAnsSec,
    questionEndTime: null,
    answerEndTime: null,
    isTimerPaused: false,
    pausedAnswerRemaining: defaultAnsSec,
    pausedRemaining: Number(s.timerSeconds) || 25,
    activeQuestionStartedAt: null,
    accumulatedActiveMs: 0,
    // مؤقت المباراة الكلي (Match-wide Clock)
    matchStartedAt: Number(s.matchDurationMinutes) > 0 ? now : null,
    matchTotalPausedMs: 0,
    isMatchClockPaused: false,
    matchClockPausedAt: null,
    isSuddenDeathTieBreaker: false,
    matchEndReason: null,
    matchEndBanner: null,
    // أنماط الاستجابة والتصويت السري
    nextResponseMode: 'BUZZER',
    activeResponseMode: 'BUZZER',
    votedTeams: [],
    revealedChoices: null,
    autoTransitionAction: null,
    autoTransitionAt: null,
    lockedTeamId: null,
    timedOutTeamId: null,
    attemptedTeamsThisQuestion: [],
    eliminatedTeams: [],
    lastEliminatedTeam: null,
    boardNotice: null,
    refereeNotice: null,
    lastStealSummary: null,
    lastSpeedBonusAwarded: 0,
    canUndoEvaluation: false,
    undoSummary: '',
    scores: scores,
    powerUps: buildPowerUpsQuota(s),
    activeEffects: getEmptyEffects(),
    telemetry: buildInitialTelemetry(),
    serverNow: now
  };
}

// 10. إدارة الاختيارات السرية المعزولة (PROP_KEY_SECRET_CHOICES)
function getSecretChoicesMap() {
  try {
    const raw = PropertiesService.getScriptProperties().getProperty(PROP_KEY_SECRET_CHOICES);
    return raw ? JSON.parse(raw) : {};
  } catch (e) {
    Logger.log('getSecretChoicesMap parse error: ' + e);
    return {};
  }
}

function persistSecretChoicesMap(mapObj) {
  PropertiesService.getScriptProperties().setProperty(
    PROP_KEY_SECRET_CHOICES,
    JSON.stringify(mapObj || {})
  );
}

function clearSecretChoicesMap() {
  PropertiesService.getScriptProperties().deleteProperty(PROP_KEY_SECRET_CHOICES);
}

// 11. المحرك الديناميكي لبناء مصفوفة الفئات والجولات
function rebuildStateBoardSnapshot(state, preloadedQuestions) {
  const allQ = Array.isArray(preloadedQuestions) ? preloadedQuestions : readQuestionsFromSheetDirect();
  const usedSet = new Set((state.usedQuestionIds || []).map(Number));
  const roundFilter = cleanArabicLabel(state.selectedRound, 'ALL');
  const matrix = {};

  allQ.forEach(q => {
    const qRound = cleanArabicLabel(q.round, 'الجولة 1');
    if (roundFilter !== 'ALL' && qRound !== roundFilter) return;

    const cat = cleanArabicLabel(q.category, 'عام');
    const diff = normalizeDifficulty(q.difficulty);

    if (!matrix[cat]) {
      matrix[cat] = { 'سهل': 0, 'متوسط': 0, 'صعب': 0 };
    }
    if (!usedSet.has(Number(q.id))) {
      matrix[cat][diff]++;
    }
  });

  state.boardMatrix = matrix;
  state.totalQuestionsCount = allQ.length;
  return allQ;
}

// 12. طبقة الحفظ الثنائية (PropertiesService موثوقة + CacheService سريعة للقراءة)
function persistLiveState(state) {
  const now = Date.now();
  state.stateRevision = (Number(state.stateRevision) || 0) + 1;
  state.stateTimestamp = now;
  state.serverNow = now;
  ensureTelemetryStructure(state);

  const matrixPayload = {
    boardMatrix: state.boardMatrix || {},
    totalQuestionsCount: Number(state.totalQuestionsCount) || 0
  };

  const coreState = Object.assign({}, state);
  delete coreState.boardMatrix;
  delete coreState.secretChoices;

  const coreJson = JSON.stringify(coreState);
  const matrixJson = JSON.stringify(matrixPayload);

  PropertiesService.getScriptProperties().setProperties({
    [PROP_KEY_STATE]: coreJson,
    [PROP_KEY_MATRIX]: matrixJson
  }, false);

  try {
    // التحقق من حد الـ 100KB في CacheService قبل التخزين
    if (coreJson.length < 95000 && matrixJson.length < 95000) {
      CacheService.getScriptCache().putAll({
        [CACHE_KEY_STATE]: coreJson,
        [CACHE_KEY_MATRIX]: matrixJson
      }, CACHE_TTL_SECONDS);
    }
  } catch (e) {
    Logger.log('persistLiveState: cache write warning: ' + e);
  }
}

function getAuthoritativeGameState() {
  const props = PropertiesService.getScriptProperties().getProperties();
  const rawState = props[PROP_KEY_STATE];
  const rawMatrix = props[PROP_KEY_MATRIX];
  let state;

  if (rawState) {
    state = JSON.parse(rawState);
    if (rawMatrix) {
      const mObj = JSON.parse(rawMatrix);
      state.boardMatrix = mObj.boardMatrix || {};
      state.totalQuestionsCount = Number(mObj.totalQuestionsCount) || 0;
    } else {
      rebuildStateBoardSnapshot(state);
      persistLiveState(state);
    }
  } else {
    state = buildFreshState(readSettingsFromSheet());
    rebuildStateBoardSnapshot(state);
    persistLiveState(state);
  }

  state.settings = sanitizeSettingsPayload(state.settings);
  ensureTelemetryStructure(state);
  if (!state.nextResponseMode) state.nextResponseMode = 'BUZZER';
  if (!state.activeResponseMode) state.activeResponseMode = 'BUZZER';
  if (!Array.isArray(state.votedTeams)) state.votedTeams = [];

  state.serverNow = Date.now();
  return state;
}

function getInternalGameState() {
  return getAuthoritativeGameState();
}

function getCachedOrAuthoritativeState() {
  try {
    const cached = CacheService.getScriptCache().getAll([CACHE_KEY_STATE, CACHE_KEY_MATRIX]);
    if (cached && cached[CACHE_KEY_STATE]) {
      const state = JSON.parse(cached[CACHE_KEY_STATE]);
      if (cached[CACHE_KEY_MATRIX]) {
        const mObj = JSON.parse(cached[CACHE_KEY_MATRIX]);
        state.boardMatrix = mObj.boardMatrix || {};
        state.totalQuestionsCount = Number(mObj.totalQuestionsCount) || 0;
      }
      ensureTelemetryStructure(state);
      state.serverNow = Date.now();
      return state;
    }
  } catch (e) {
    Logger.log('getCachedOrAuthoritativeState fallback: ' + e);
  }
  return getAuthoritativeGameState();
}

// تعقيم الحالة للعملاء: منع أي تسريب للإجابة الصحيحة أو لاختيارات المنافسين السرية + حقن حالة الأدوات
function sanitizeStateForClient(rawState, viewerTeamId) {
  const safeState = JSON.parse(JSON.stringify(rawState));
  safeState.serverNow = Date.now();

  delete safeState.secretChoices;

  const isRevealFsm = ['ANSWER_CORRECT', 'ANSWER_WRONG', 'CHOICE_REVEALED'].includes(safeState.fsmState);
  if (safeState.currentQuestion && !isRevealFsm) {
    delete safeState.currentQuestion.correct;
  }

  if (safeState.fsmState !== 'CHOICE_REVEALED') {
    safeState.revealedChoices = null;
  }

  safeState.mySecretChoice = null;
  if (
    viewerTeamId &&
    safeState.activeResponseMode === 'SILENT_CHOICE' &&
    safeState.fsmState === 'QUESTION_ACTIVE'
  ) {
    const vId = String(viewerTeamId);
    if (Array.isArray(safeState.votedTeams) && safeState.votedTeams.includes(vId)) {
      const secrets = getSecretChoicesMap();
      if (secrets[vId] && secrets[vId].choice) {
        safeState.mySecretChoice = secrets[vId].choice;
      }
    }
  }

  if (viewerTeamId) {
    safeState.myPowerUpGate = evaluatePowerUpGateForTeam(safeState, String(viewerTeamId));
  }

  safeState.telemetrySummary = computeLiveTelemetrySummary(safeState);
  return safeState;
}

function stripCorrectAnswers(questionsList) {
  return (questionsList || []).map(q => ({
    id: q.id,
    round: q.round,
    category: q.category,
    difficulty: q.difficulty,
    question: q.question,
    options: q.options,
    mediaUrl: q.mediaUrl || '',
    mediaType: q.mediaType || 'none',
    mediaDriveId: q.mediaDriveId || ''
  }));
}

// 13. قراءة الحالة الحية لجميع الشاشات + فحص انتهاء وقت المباراة الكلي تلقائياً
function getGameState(viewerTeamId) {
  const state = getCachedOrAuthoritativeState();
  const s = state.settings || {};
  const durationMins = Number(s.matchDurationMinutes) || 0;

  if (
    durationMins > 0 &&
    state.matchStartedAt &&
    !state.isMatchClockPaused &&
    state.fsmState !== 'CELEBRATION_PODIUM' &&
    state.fsmState !== 'BUZZER_LOCKED'
  ) {
    const elapsedMs = getEffectiveMatchElapsedMs(state, Date.now());
    if (elapsedMs >= durationMins * 60 * 1000) {
      const lock = LockService.getScriptLock();
      if (lock.tryLock(1500)) {
        try {
          const authState = getAuthoritativeGameState();
          const term = checkAndApplyMatchTermination(authState, Date.now(), false);
          if (term.terminated || term.suddenDeath) {
            persistLiveState(authState);
          }
          return sanitizeStateForClient(authState, viewerTeamId || null);
        } finally {
          lock.releaseLock();
        }
      }
    }
  }

  return sanitizeStateForClient(state, viewerTeamId || null);
}

// 14. لقطة التراجع بضغطة واحدة (PROP_KEY_UNDO)
function saveUndoSnapshot(state, summaryText, secretChoicesSnapshot) {
  const snapshot = {
    savedAt: Date.now(),
    summary: summaryText,
    scores: Object.assign({}, state.scores),
    powerUps: JSON.parse(JSON.stringify(state.powerUps)),
    activeEffects: JSON.parse(JSON.stringify(state.activeEffects)),
    activeTurnTeamId: state.activeTurnTeamId,
    fsmState: state.fsmState,
    lockedTeamId: state.lockedTeamId,
    timedOutTeamId: state.timedOutTeamId,
    attemptedTeamsThisQuestion: (state.attemptedTeamsThisQuestion || []).slice(),
    questionsCompletedCount: Number(state.questionsCompletedCount) || 0,
    isSuddenDeathTieBreaker: Boolean(state.isSuddenDeathTieBreaker),
    currentQuestion: state.currentQuestion ? JSON.parse(JSON.stringify(state.currentQuestion)) : null,
    currentQuestionPoints: state.currentQuestionPoints,
    activeResponseMode: state.activeResponseMode || 'BUZZER',
    votedTeams: (state.votedTeams || []).slice(),
    revealedChoices: state.revealedChoices ? JSON.parse(JSON.stringify(state.revealedChoices)) : null,
    secretChoicesSnapshot: secretChoicesSnapshot ? JSON.parse(JSON.stringify(secretChoicesSnapshot)) : null,
    telemetry: JSON.parse(JSON.stringify(state.telemetry || buildInitialTelemetry())),
    pausedRemaining: state.pausedRemaining,
    pausedAnswerRemaining: state.pausedAnswerRemaining
  };
  PropertiesService.getScriptProperties().setProperty(PROP_KEY_UNDO, JSON.stringify(snapshot));
  state.canUndoEvaluation = true;
  state.undoSummary = summaryText;
}

function clearUndoSnapshot(state) {
  PropertiesService.getScriptProperties().deleteProperty(PROP_KEY_UNDO);
  if (state) {
    state.canUndoEvaluation = false;
    state.undoSummary = '';
  }
}

// 15. حفظ الإعدادات الدائمة + تهيئة مباراة جديدة مخصصة من غرفة القيادة أو الاستوديو
function writeSettingsObjectToSheet(sanitized) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sSheet = ss.getSheetByName('Settings');
  if (!sSheet) {
    sSheet = ss.insertSheet('Settings');
  }
  const rows = Object.entries(sanitized).map(([k, v]) => [k, String(v)]);
  sSheet.clearContents();
  sSheet.getRange(1, 1, 1, 2).setValues([['SettingKey', 'SettingValue']]).setFontWeight('bold').setBackground('#e2e8f0');
  sSheet.setFrozenRows(1);
  sSheet.getRange(2, 1, rows.length, 2).setValues(rows);
}

function saveGameSettings(newSettings) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const merged = Object.assign({}, state.settings, newSettings || {});
    const sanitized = sanitizeSettingsPayload(merged);

    writeSettingsObjectToSheet(sanitized);

    state.settings = sanitized;
    state.powerUps = buildPowerUpsQuota(sanitized);

    const ansSec = resolveAnswerDurationSeconds(state, state.currentQuestion);
    state.currentAnswerDurationSec = ansSec;

    if (Number(sanitized.matchDurationMinutes) > 0 && !state.matchStartedAt) {
      state.matchStartedAt = Date.now();
      state.matchTotalPausedMs = 0;
      state.isMatchClockPaused = false;
      state.matchClockPausedAt = null;
    } else if (Number(sanitized.matchDurationMinutes) === 0) {
      state.matchStartedAt = null;
      state.matchTotalPausedMs = 0;
      state.isMatchClockPaused = false;
      state.matchClockPausedAt = null;
    }

    const isBoardBased = (sanitized.playMode === 'BOARD' || sanitized.playMode === 'AUTO_CATEGORY');
    if (state.fsmState === 'WAITING_LOBBY' || state.fsmState === 'CATEGORY_BOARD') {
      state.fsmState = isBoardBased ? 'CATEGORY_BOARD' : 'WAITING_LOBBY';
      state.pausedRemaining = sanitized.timerSeconds;
      state.pausedAnswerRemaining = ansSec;
    }
    persistLiveState(state);

    return { status: 'OK', state: sanitizeStateForClient(state) };
  } finally {
    lock.releaseLock();
  }
}

