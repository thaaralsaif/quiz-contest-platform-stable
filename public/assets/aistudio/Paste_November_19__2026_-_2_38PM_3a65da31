// 17. اختيار سؤال ديناميكياً من لوحة الفئات والصعوبات
function pickBoardQuestion(category, difficulty) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return { status: 'BUSY' };
  try {
    const state = getAuthoritativeGameState();
    const allQ = readQuestionsFromSheetDirect();
    const used = (state.usedQuestionIds || []).map(Number);
    const targetCat = cleanArabicLabel(category, '');
    const targetDiff = normalizeDifficulty(difficulty);
    const activeRound = cleanArabicLabel(state.selectedRound, 'ALL');

    const candidate = allQ.find(q =>
      !used.includes(Number(q.id)) &&
      (activeRound === 'ALL' || cleanArabicLabel(q.round, 'الجولة 1') === activeRound) &&
      cleanArabicLabel(q.category, 'عام') === targetCat &&
      normalizeDifficulty(q.difficulty) === targetDiff
    );

    if (!candidate) {
      rebuildStateBoardSnapshot(state, allQ);
      persistLiveState(state);
      return { status: 'EMPTY_SLOT', message: 'نفدت أسئلة هذا المستوى في هذه الفئة', state: sanitizeStateForClient(state) };
    }

    state.selectedCategory = targetCat;
    state.selectedDifficulty = targetDiff;
    state.boardNotice = null;

    return launchQuestionInternal(state, candidate, allQ);
  } finally {
    lock.releaseLock();
  }
}

