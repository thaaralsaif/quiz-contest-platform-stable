// 26. قراءة بنك الأسئلة الديناميكي (متوافق رجعياً مع 9 و 10 أعمدة - قراءة فقط)
function readQuestionsFromSheetDirect() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Questions');
  if (!sheet || sheet.getLastRow() < 2) return [];
  const lastRow = sheet.getLastRow();
  const cols = Math.max(9, sheet.getLastColumn());
  const rows = sheet.getRange(2, 1, lastRow - 1, cols).getValues();

  const seenIds = new Set();
  let maxId = 0;
  rows.forEach(r => {
    const n = Number(r[0]);
    if (Number.isInteger(n) && n > maxId) maxId = n;
  });

  const result = [];

  rows.forEach(r => {
    let rawId = Number(r[0]);
    if (!Number.isInteger(rawId) || rawId <= 0 || seenIds.has(rawId)) {
      maxId++;
      rawId = maxId;
    }
    seenIds.add(rawId);

    const questionText = cleanArabicLabel(r[4], '');
    if (!questionText) return;

    const rawMedia = (r.length >= 10) ? r[9] : '';
    const mediaMeta = parseMediaMetadata(rawMedia);

    result.push({
      id: rawId,
      round: cleanArabicLabel(r[1], 'الجولة 1'),
      category: cleanArabicLabel(r[2], 'عام'),
      difficulty: normalizeDifficulty(r[3]),
      question: questionText,
      options: {
        A: cleanArabicLabel(r[5], ''),
        B: cleanArabicLabel(r[6], ''),
        C: cleanArabicLabel(r[7], '')
      },
      correct: cleanArabicLabel(r[8], 'A').toUpperCase(),
      mediaUrl: mediaMeta.mediaUrl,
      mediaType: mediaMeta.mediaType,
      mediaDriveId: mediaMeta.mediaDriveId
    });
  });

  return result;
}

function healQuestionIdsIfNeeded() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(2000)) {
    Logger.log('healQuestionIdsIfNeeded: skipped, lock busy');
    return false;
  }
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Questions');
    if (!sheet || sheet.getLastRow() < 2) return false;

    const lastRow = sheet.getLastRow();
    const idRange = sheet.getRange(2, 1, lastRow - 1, 1);
    const ids = idRange.getValues();

    const seenIds = new Set();
    let maxId = 0;
    ids.forEach(([v]) => {
      const n = Number(v);
      if (Number.isInteger(n) && n > maxId) maxId = n;
    });

    let modified = false;
    const fixedIdColumn = ids.map(([v]) => {
      let rawId = Number(v);
      if (!Number.isInteger(rawId) || rawId <= 0 || seenIds.has(rawId)) {
        maxId++;
        rawId = maxId;
        modified = true;
      }
      seenIds.add(rawId);
      return [rawId];
    });

    if (modified) {
      idRange.setValues(fixedIdColumn);
    }
    return modified;
  } catch (e) {
    Logger.log('healQuestionIdsIfNeeded failed: ' + e);
    return false;
  } finally {
    lock.releaseLock();
  }
}

